date-time Valibot: v.pipe(v.string(), v.regex(/^\d{4}-\d{2}-\d{2}[Tt]([01]\d|2[0-3]):[0-5]\d:[0-5]\d(\.\d{1,9})?([Zz]|[+-]([01]\d|2[0-3]):[0-5]\d)?$/), v.check((s) => { const d = new Date(s.slice(0, 10) + "T00:00:00Z"); return !isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s.slice(0, 10); }, "Invalid datetime"))
date-time Zod4 fragment: z.string().regex(/^\d{4}-\d{2}-\d{2}[Tt]([01]\d|2[0-3]):[0-5]\d:[0-5]\d(\.\d{1,9})?([Zz]|[+-]([01]\d|2[0-3]):[0-5]\d)?$/).refine((s) => { const d = new Date(s.slice(0, 10) + "T00:00:00Z"); return !isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s.slice(0, 10); }, { error: "Invalid datetime" })

