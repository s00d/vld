ip Zod4 fragment: z.string().refine((s) => z.ipv4().safeParse(s).success || z.ipv6().safeParse(s).success, { error: "Invalid IP" })

cidr Zod: z.string().refine((s) => { const i = s.indexOf("/"); if (i < 0) return false; const a = s.slice(0, i), p = s.slice(i + 1); if (!/^(0|[1-9]\d{0,2})$/.test(p)) return false; return z.string().ip({ version: "v4" }).safeParse(a).success ? +p <= 32 : z.string().ip({ version: "v6" }).safeParse(a).success && +p <= 128; }, "Invalid CIDR")
cidr Zod4: z.string().refine((s) => { const i = s.indexOf("/"); if (i < 0) return false; const a = s.slice(0, i), p = s.slice(i + 1); if (!/^(0|[1-9]\d{0,2})$/.test(p)) return false; return z.ipv4().safeParse(a).success ? +p <= 32 : z.ipv6().safeParse(a).success && +p <= 128; }, { error: "Invalid CIDR" })
cidr Valibot: v.pipe(v.string(), v.check((s) => { const i = s.indexOf("/"); if (i < 0) return false; const a = s.slice(0, i), p = s.slice(i + 1); if (!/^(0|[1-9]\d{0,2})$/.test(p)) return false; return v.safeParse(v.pipe(v.string(), v.ipv4()), a).success ? +p <= 32 : v.safeParse(v.pipe(v.string(), v.ipv6()), a).success && +p <= 128; }, "Invalid CIDR"))
cidr Zod4 fragment: z.string().refine((s) => { const i = s.indexOf("/"); if (i < 0) return false; const a = s.slice(0, i), p = s.slice(i + 1); if (!/^(0|[1-9]\d{0,2})$/.test(p)) return false; return z.ipv4().safeParse(a).success ? +p <= 32 : z.ipv6().safeParse(a).success && +p <= 128; }, { error: "Invalid CIDR" })

date Zod: z.string().regex(/^\d{4}-\d{2}-\d{2}$/).refine((s) => { const d = new Date(s.slice(0, 10) + "T00:00:00Z"); return !isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s.slice(0, 10); }, "Invalid date")
date Zod4: z.iso.date()
date Valibot: v.pipe(v.string(), v.regex(/^\d{4}-\d{2}-\d{2}$/), v.check((s) => { const d = new Date(s.slice(0, 10) + "T00:00:00Z"); return !isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s.slice(0, 10); }, "Invalid date"))
date Zod4 fragment: z.string().refine((s) => z.iso.date().safeParse(s).success, { error: "Invalid date" })

date-time Zod: z.string().regex(/^\d{4}-\d{2}-\d{2}[Tt]([01]\d|2[0-3]):[0-5]\d:[0-5]\d(\.\d{1,9})?([Zz]|[+-]([01]\d|2[0-3]):[0-5]\d)?$/).refine((s) => { const d = new Date(s.slice(0, 10) + "T00:00:00Z"); return !isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s.slice(0, 10); }, "Invalid datetime")
date-time Zod4: z.string().regex(/^\d{4}-\d{2}-\d{2}[Tt]([01]\d|2[0-3]):[0-5]\d:[0-5]\d(\.\d{1,9})?([Zz]|[+-]([01]\d|2[0-3]):[0-5]\d)?$/).refine((s) => { const d = new Date(s.slice(0, 10) + "T00:00:00Z"); return !isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s.slice(0, 10); }, { error: "Invalid datetime" })
date-time Valibot: v.pipe(v.string(), v.regex(/^\d{4}-\d{2}-\d{2}[Tt]([01]\d|2[0-3]):[0-5]\d:[0-5]\d(\.\d{1,9})?([Zz]|[+-]([01]\d|2[0-3]):[0-5]\d)?$/), v.check((s) => { const d = new Date(s.slice(0, 10) + "T00:00:00Z"); return !isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s.slice(0, 10); }, "Invalid datetime"))
date-time Zod4 fragment: z.string().regex(/^\d{4}-\d{2}-\d{2}[Tt]([01]\d|2[0-3]):[0-5]\d:[0-5]\d(\.\d{1,9})?([Zz]|[+-]([01]\d|2[0-3]):[0-5]\d)?$/).refine((s) => { const d = new Date(s.slice(0, 10) + "T00:00:00Z"); return !isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s.slice(0, 10); }, { error: "Invalid datetime" })

time Zod: z.string().regex(/^([01]\d|2[0-3]):[0-5]\d(:[0-5]\d(\.\d{1,9})?)?$/)
time Zod4: z.iso.time().regex(/^([01]\d|2[0-3]):[0-5]\d(:[0-5]\d(\.\d{1,9})?)?$/)
time Valibot: v.pipe(v.string(), v.regex(/^([01]\d|2[0-3]):[0-5]\d(:[0-5]\d(\.\d{1,9})?)?$/))
time Zod4 fragment: z.string().regex(/^([01]\d|2[0-3]):[0-5]\d(:[0-5]\d(\.\d{1,9})?)?$/).refine((s) => z.iso.time().safeParse(s).success, { error: "Invalid time" })

hostname Zod: z.string().regex(/^(?=.{1,253}$)[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$/)
hostname Zod4: z.string().regex(/^(?=.{1,253}$)[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$/)
hostname Valibot: v.pipe(v.string(), v.regex(/^(?=.{1,253}$)[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$/))
hostname Zod4 fragment: z.string().regex(/^(?=.{1,253}$)[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$/)

