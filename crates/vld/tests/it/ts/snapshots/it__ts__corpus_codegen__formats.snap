json Zod: z.string().refine((s) => { try { JSON.parse(s); return true; } catch { return false; } }, "Invalid JSON")
json Zod4: z.string().refine((s) => { try { JSON.parse(s); return true; } catch { return false; } }, { error: "Invalid JSON" })
json Valibot: v.pipe(v.string(), v.check((s) => { try { JSON.parse(s); return true; } catch { return false; } }, "Invalid JSON"))
json Zod4 fragment: z.string().refine((s) => { try { JSON.parse(s); return true; } catch { return false; } }, { error: "Invalid JSON" })

cuid2 Zod: z.string().regex(/^[a-z][a-z0-9]{1,31}$/)
cuid2 Zod4: z.string().regex(/^[a-z][a-z0-9]{1,31}$/)
cuid2 Valibot: v.pipe(v.string(), v.regex(/^[a-z][a-z0-9]{1,31}$/))
cuid2 Zod4 fragment: z.string().regex(/^[a-z][a-z0-9]{1,31}$/)

ulid Zod: z.string().regex(/^[0-7][0-9A-HJKMNP-TV-Z]{25}$/i)
ulid Zod4: z.string().regex(/^[0-7][0-9A-HJKMNP-TV-Z]{25}$/i)
ulid Valibot: v.pipe(v.string(), v.regex(/^[0-7][0-9A-HJKMNP-TV-Z]{25}$/i))
ulid Zod4 fragment: z.string().regex(/^[0-7][0-9A-HJKMNP-TV-Z]{25}$/i)

nanoid Zod: z.string().regex(/^[A-Za-z0-9_-]+$/)
nanoid Zod4: z.string().regex(/^[A-Za-z0-9_-]+$/)
nanoid Valibot: v.pipe(v.string(), v.regex(/^[A-Za-z0-9_-]+$/))
nanoid Zod4 fragment: z.string().regex(/^[A-Za-z0-9_-]+$/)

emoji Zod: z.string().regex(/^[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{1F1E0}-\u{1F1FF}\u{2702}-\u{27B0}\u{2600}-\u{26FF}\u{FE00}-\u{FE0F}\u{1F900}-\u{1F9FF}\u{1FA00}-\u{1FAFF}\u{231A}-\u{231B}\u{23E9}-\u{23F3}\u{23F8}-\u{23FA}\u{E0020}-\u{E007F}\u{20E3}\u{200D}\u{2B50}]+$/u)
emoji Zod4: z.string().regex(/^[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{1F1E0}-\u{1F1FF}\u{2702}-\u{27B0}\u{2600}-\u{26FF}\u{FE00}-\u{FE0F}\u{1F900}-\u{1F9FF}\u{1FA00}-\u{1FAFF}\u{231A}-\u{231B}\u{23E9}-\u{23F3}\u{23F8}-\u{23FA}\u{E0020}-\u{E007F}\u{20E3}\u{200D}\u{2B50}]+$/u)
emoji Valibot: v.pipe(v.string(), v.regex(/^[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{1F1E0}-\u{1F1FF}\u{2702}-\u{27B0}\u{2600}-\u{26FF}\u{FE00}-\u{FE0F}\u{1F900}-\u{1F9FF}\u{1FA00}-\u{1FAFF}\u{231A}-\u{231B}\u{23E9}-\u{23F3}\u{23F8}-\u{23FA}\u{E0020}-\u{E007F}\u{20E3}\u{200D}\u{2B50}]+$/u))
emoji Zod4 fragment: z.string().regex(/^[\u{1F600}-\u{1F64F}\u{1F300}-\u{1F5FF}\u{1F680}-\u{1F6FF}\u{1F1E0}-\u{1F1FF}\u{2702}-\u{27B0}\u{2600}-\u{26FF}\u{FE00}-\u{FE0F}\u{1F900}-\u{1F9FF}\u{1FA00}-\u{1FAFF}\u{231A}-\u{231B}\u{23E9}-\u{23F3}\u{23F8}-\u{23FA}\u{E0020}-\u{E007F}\u{20E3}\u{200D}\u{2B50}]+$/u)

decimal Zod: z.string()
decimal Zod4: z.string()
decimal Valibot: v.string()
decimal Zod4 fragment: z.string()
