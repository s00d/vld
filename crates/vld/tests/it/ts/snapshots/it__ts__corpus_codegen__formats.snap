isbn Zod: z.string().refine((s) => { if (/^[- ]|[- ]$|[- ]{2}/.test(s)) return false; const d = s.replace(/[- ]/g, ""); if (/^\d{9}[\dX]$/.test(d)) { let sum = 0; for (let i = 0; i < 10; i++) sum += (10 - i) * (d[i] === "X" ? 10 : +d[i]); return sum % 11 === 0; } if (!/^97[89]\d{10}$/.test(d)) return false; let sum = 0; for (let i = 0; i < 13; i++) sum += +d[12 - i] * (i % 2 ? 3 : 1); return sum % 10 === 0; }, "Invalid ISBN")
