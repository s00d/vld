ean Zod: z.string().refine((s) => { if (!/^(\d{8}|\d{12,14})$/.test(s)) return false; let sum = 0; for (let i = 0; i < s.length; i++) sum += +s[s.length - 1 - i] * (i % 2 ? 3 : 1); return sum % 10 === 0; }, "Invalid EAN")
