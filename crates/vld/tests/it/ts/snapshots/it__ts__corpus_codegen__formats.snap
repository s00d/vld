---
source: crates/vld/tests/it/ts/corpus_codegen.rs
expression: out
---
email Zod: z.string().email()
email Zod4: z.email()
email Valibot: v.pipe(v.string(), v.email())
email Zod4 fragment: z.string().refine((s) => z.email().safeParse(s).success, { error: "Invalid email" })

uri Zod: z.string().url().regex(/^https?:\/\/\S+$/)
