cron Zod: z.string().refine((s) => { if (s.startsWith("@")) return ["@yearly", "@annually", "@monthly", "@weekly", "@daily", "@midnight", "@hourly"].includes(s); const f = s.trim().split(/\s+/); const M = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], D = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]; let spec = [[0, 59, [], 0], [0, 59, [], 0], [0, 23, [], 0], [1, 31, [], 1], [1, 12, M, 0], [0, 7, D, 1]]; if (f.length === 5) spec = spec.slice(1); else if (f.length !== 6) return false; return f.every((x, i) => { const [lo, hi, names, q] = spec[i]; const val = (v) => { if (/^\d+$/.test(v)) { const n = +v; return n >= lo && n <= hi ? n : null; } const k = names.indexOf(v.toUpperCase()); return k >= 0 ? lo + k : null; }; if (q && x === "?") return true; return x.split(",").every((it) => { const [b, st, extra] = it.split("/"); if (extra !== undefined) return false; if (st !== undefined && !(/^\d+$/.test(st) && +st >= 1 && +st <= Math.max(hi, 1))) return false; if (b === "*") return true; const r = b.split("-"); if (r.length === 2) { const a = val(r[0]), c = val(r[1]); return a !== null && c !== null && a <= c; } return r.length === 1 && val(b) !== null; }); }); }, "Invalid cron expression")
