color Zod: z.string().regex(/^(?:#(?:[0-9a-f]{6}|[0-9a-f]{8})|rgb\(\s*\+?0*(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\s*,\s*\+?0*(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\s*,\s*\+?0*(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)\s*\)|hsl\(\s*\+?0*(?:360|3[0-5]\d|[12]?\d?\d)\s*,\s*\+?0*(?:100|[1-9]?\d)%\s*,\s*\+?0*(?:100|[1-9]?\d)%\s*\))$/i)
