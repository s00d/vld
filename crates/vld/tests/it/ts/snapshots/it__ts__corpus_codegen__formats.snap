timezone Zod: z.string().regex(/^(?=.{1,255}$)[A-Z][A-Za-z0-9_+-]*(?:\/[A-Z][A-Za-z0-9_+-]*){0,2}$/)
timezone Zod4: z.string().regex(/^(?=.{1,255}$)[A-Z][A-Za-z0-9_+-]*(?:\/[A-Z][A-Za-z0-9_+-]*){0,2}$/)
timezone Valibot: v.pipe(v.string(), v.regex(/^(?=.{1,255}$)[A-Z][A-Za-z0-9_+-]*(?:\/[A-Z][A-Za-z0-9_+-]*){0,2}$/))
timezone Zod4 fragment: z.string().regex(/^(?=.{1,255}$)[A-Z][A-Za-z0-9_+-]*(?:\/[A-Z][A-Za-z0-9_+-]*){0,2}$/)

mime Zod: z.string().regex(/^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}\/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}(?:;[ \t]*[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}=(?:[!#$%&'*+.^_`|~0-9A-Za-z-]+|"(?:[^"\\\x00-\x1f\x7f-\x9f]|\\[^\x00-\x1f\x7f-\x9f])*"))*$/)
mime Zod4: z.string().regex(/^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}\/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}(?:;[ \t]*[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}=(?:[!#$%&'*+.^_`|~0-9A-Za-z-]+|"(?:[^"\\\x00-\x1f\x7f-\x9f]|\\[^\x00-\x1f\x7f-\x9f])*"))*$/)
mime Valibot: v.pipe(v.string(), v.regex(/^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}\/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}(?:;[ \t]*[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}=(?:[!#$%&'*+.^_`|~0-9A-Za-z-]+|"(?:[^"\\\x00-\x1f\x7f-\x9f]|\\[^\x00-\x1f\x7f-\x9f])*"))*$/))
mime Zod4 fragment: z.string().regex(/^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}\/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}(?:;[ \t]*[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}=(?:[!#$%&'*+.^_`|~0-9A-Za-z-]+|"(?:[^"\\\x00-\x1f\x7f-\x9f]|\\[^\x00-\x1f\x7f-\x9f])*"))*$/)

objectid Zod: z.string().regex(/^[0-9a-fA-F]{24}$/)
objectid Zod4: z.string().regex(/^[0-9a-fA-F]{24}$/)
objectid Valibot: v.pipe(v.string(), v.regex(/^[0-9a-fA-F]{24}$/))
objectid Zod4 fragment: z.string().regex(/^[0-9a-fA-F]{24}$/)

regex Zod: z.string().refine((s) => { try { new RegExp(s, "u"); return true; } catch { return false; } }, "Invalid regular expression")
regex Zod4: z.string().refine((s) => { try { new RegExp(s, "u"); return true; } catch { return false; } }, { error: "Invalid regular expression" })
regex Valibot: v.pipe(v.string(), v.check((s) => { try { new RegExp(s, "u"); return true; } catch { return false; } }, "Invalid regular expression"))
regex Zod4 fragment: z.string().refine((s) => { try { new RegExp(s, "u"); return true; } catch { return false; } }, { error: "Invalid regular expression" })

single-script Zod: z.string() /* single-script (Unicode TS #39) not checked */
single-script Zod4: z.string() /* single-script (Unicode TS #39) not checked */
single-script Valibot: v.string() /* single-script (Unicode TS #39) not checked */
single-script Zod4 fragment: z.string() /* single-script (Unicode TS #39) not checked */

password Zod: z.string()
password Zod4: z.string()
password Valibot: v.string()
password Zod4 fragment: z.string()

decimal Zod: z.string()
decimal Zod4: z.string()
decimal Valibot: v.string()
decimal Zod4 fragment: z.string()
