---
source: crates/vld/tests/it/ts/story_typescript_module.rs
expression: zod4
---
z.object({
  id: z.string().min(1),
  shipping: z.lazy(() => TsAddressSchema)
})

export const TsProfileSchema = z.object({
  email: z.email(),
  role: z.union([z.literal("admin"), z.literal("user")]),
  nickname: z.string().min(2).optional(),
  address: z.lazy(() => TsAddressSchema)
});
export type TsProfile = z.infer<typeof TsProfileSchema>;


export const RequestBodySchema = z.object({
  name: z.string().min(1)
});
export type RequestBody = z.infer<typeof RequestBodySchema>;


z.guid()

z.string().regex(/^\d{4}-\d{2}-\d{2}[Tt]([01]\d|2[0-3]):[0-5]\d:[0-5]\d(\.\d{1,9})?([Zz]|[+-]([01]\d|2[0-3]):[0-5]\d)?$/).refine((s) => { const d = new Date(s.slice(0, 10) + "T00:00:00Z"); return !isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s.slice(0, 10); }, { error: "Invalid datetime" })

z.iso.date()

z.iso.time().regex(/^([01]\d|2[0-3]):[0-5]\d(:[0-5]\d(\.\d{1,9})?)?$/)

z.ipv4()

z.url().regex(/^https?:\/\/\S+$/)

z.int().min(1)

z.array(z.string()).refine((a) => new Set(a.map((x) => JSON.stringify(x))).size === a.length, { error: "Items must be unique" })
