---
source: tests/all/json_schema/mod.rs
expression: value
---
{
  "components": {
    "schemas": {
      "CreateProfile": {
        "properties": {
          "address": {
            "$ref": "#/components/schemas/ProfileAddress"
          },
          "age": {
            "anyOf": [
              {
                "maximum": 150,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "years"
          },
          "bio": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "isCurrent": {
            "default": false,
            "type": "boolean"
          },
          "locale": {
            "anyOf": [
              {
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "meta": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "opaque meta"
          },
          "name": {
            "description": "display name",
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "nickname": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "display nickname"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "default": "user",
            "description": "account role",
            "type": "string"
          },
          "tags": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "name",
          "email",
          "tags",
          "address"
        ],
        "type": "object"
      },
      "ProfileAddress": {
        "properties": {
          "city": {
            "minLength": 2,
            "type": "string"
          },
          "street": {
            "description": "street line",
            "minLength": 1,
            "type": "string"
          },
          "zip": {
            "anyOf": [
              {
                "minLength": 4,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "postal code"
          }
        },
        "required": [
          "street",
          "city"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {}
}
