g","9.changelog",{"id":384,"title":11,"body":385,"description":863,"extension":864,"links":865,"meta":866,"navigation":867,"path":12,"seo":868,"stem":13,"__hash__":869},"docs\u002F1.getting-started\u002F1.introduction.md",{"type":386,"value":387,"toc":856},"minimark",[388,413,418,424,433,492,496,499,760,763,829,846],[389,390,391,395,396,403,404,407,408,412],"p",{},[392,393,394],"code",{},"vld"," is a runtime validation library for Rust, modelled on ",[397,398,402],"a",{"href":399,"rel":400},"https:\u002F\u002Fzod.dev",[401],"nofollow","Zod",". You describe the shape of your data with schema values, then parse untrusted input with them. A successful parse returns typed Rust values; a failed one returns a ",[392,405,406],{},"VldError"," listing ",[409,410,411],"strong",{},"every"," problem with its path.",[414,415,417],"h2",{"id":416},"why-not-just-serde","Why not just serde?",[389,419,420,423],{},[392,421,422],{},"serde"," turns JSON into Rust types and stops at the first error. It knows nothing about lengths, formats, ranges or cross-field rules, and its errors are strings meant for developers.",[389,425,426,428,429,432],{},[392,427,394],{}," sits on top of ",[392,430,431],{},"serde_json::Value",":",[434,435,436,454,468,481,487],"ul",{},[437,438,439,442,443,446,447,446,450,453],"li",{},[409,440,441],{},"Constraints"," live next to the type: ",[392,444,445],{},"vld::string().email()",", ",[392,448,449],{},"vld::u16().min(1)",[392,451,452],{},"vld::array(...).max_len(10)",".",[437,455,456,459,460,463,464,467],{},[409,457,458],{},"All issues at once",", each with a path (",[392,461,462],{},"items[2].email","), a typed ",[392,465,466],{},"IssueCode"," and a message you can translate.",[437,469,470,473,474,477,478,480],{},[409,471,472],{},"Typed output",": ",[392,475,476],{},"schema!"," structs and ",[392,479,88],{}," give you plain Rust structs.",[437,482,483,486],{},[409,484,485],{},"One source of truth"," for docs: every schema can emit JSON Schema \u002F OpenAPI 3.1.",[437,488,489,491],{},[409,490,140],{}," for web frameworks, databases, queues, config, CLI and UI crates reuse the same schemas and error format.",[414,493,495],{"id":494},"coming-from-zod","Coming from Zod",[389,497,498],{},"Most Zod concepts map one to one.",[500,501,502,513],"table",{},[503,504,505],"thead",{},[506,507,508,511],"tr",{},[509,510,402],"th",{},[509,512,394],{},[514,515,516,529,545,562,574,586,602,614,633,645,656,673,695,707,719,743],"tbody",{},[506,517,518,524],{},[519,520,521],"td",{},[392,522,523],{},"z.string().min(2).email()",[519,525,526],{},[392,527,528],{},"vld::string().min(2).email()",[506,530,531,536],{},[519,532,533],{},[392,534,535],{},"z.number().int().positive()",[519,537,538,541,542],{},[392,539,540],{},"vld::number().int().positive()"," or ",[392,543,544],{},"vld::u32().positive()",[506,546,547,552],{},[519,548,549],{},[392,550,551],{},"z.object({...})",[519,553,554,446,557,541,559],{},[392,555,556],{},"vld::schema! { struct ... }",[392,558,88],{},[392,560,561],{},"vld::object()",[506,563,564,569],{},[519,565,566],{},[392,567,568],{},"z.array(z.string()).max(5)",[519,570,571],{},[392,572,573],{},"vld::array(vld::string()).max_len(5)",[506,575,576,581],{},[519,577,578],{},[392,579,580],{},"z.enum([\"a\", \"b\"])",[519,582,583],{},[392,584,585],{},"vld::enumeration(&[\"a\", \"b\"])",[506,587,588,593],{},[519,589,590],{},[392,591,592],{},"z.union([...])",[519,594,595,598,599],{},[392,596,597],{},"vld::union!(a, b, c)"," \u002F ",[392,600,601],{},"a.or(b)",[506,603,604,609],{},[519,605,606],{},[392,607,608],{},"z.discriminatedUnion(\"type\", ...)",[519,610,611],{},[392,612,613],{},"vld::discriminated_union(\"type\").variant(...)",[506,615,616,627],{},[519,617,618,598,621,598,624],{},[392,619,620],{},".optional()",[392,622,623],{},".nullable()",[392,625,626],{},".nullish()",[519,628,629,630,632],{},"same names (absent-key rules: ",[397,631,66],{"href":67},")",[506,634,635,640],{},[519,636,637],{},[392,638,639],{},".default(x)",[519,641,642],{},[392,643,644],{},".with_default(x)",[506,646,647,652],{},[519,648,649],{},[392,650,651],{},".catch(x)",[519,653,654],{},[392,655,651],{},[506,657,658,666],{},[519,659,660,598,663],{},[392,661,662],{},".refine()",[392,664,665],{},".superRefine()",[519,667,668,598,670],{},[392,669,662],{},[392,671,672],{},".super_refine()",[506,674,675,686],{},[519,676,677,598,680,598,683],{},[392,678,679],{},".transform()",[392,681,682],{},".pipe()",[392,684,685],{},"z.preprocess()",[519,687,688,598,690,598,692],{},[392,689,679],{},[392,691,682],{},[392,693,694],{},"vld::preprocess()",[506,696,697,702],{},[519,698,699],{},[392,700,701],{},"z.lazy()",[519,703,704],{},[392,705,706],{},"vld::lazy()",[506,708,709,714],{},[519,710,711],{},[392,712,713],{},"z.coerce.number()",[519,715,716],{},[392,717,718],{},"vld::number().coerce()",[506,720,721,732],{},[519,722,723,598,726,598,729],{},[392,724,725],{},"error.flatten()",[392,727,728],{},"z.treeifyError()",[392,730,731],{},"z.prettifyError()",[519,733,734,598,737,598,740],{},[392,735,736],{},"flatten_error()",[392,738,739],{},"treeify_error()",[392,741,742],{},"prettify_error()",[506,744,745,750],{},[519,746,747],{},[392,748,749],{},"zod-to-json-schema",[519,751,752,753,756,757,632],{},"built in: ",[392,754,755],{},"JsonSchema::json_schema()"," (feature ",[392,758,759],{},"openapi",[389,761,762],{},"Differences worth knowing:",[434,764,765,795,809,819],{},[437,766,767,768,598,771,774,775,598,778,781,782,598,785,788,789,598,792,453],{},"Sizes are named after what they count: strings use ",[392,769,770],{},"min",[392,772,773],{},"max"," (characters), arrays ",[392,776,777],{},"min_len",[392,779,780],{},"max_len",", sets and files ",[392,783,784],{},"min_size",[392,786,787],{},"max_size",", objects and records ",[392,790,791],{},"min_keys",[392,793,794],{},"max_keys",[437,796,797,798,446,801,804,805,808],{},"Integers are their own schemas (",[392,799,800],{},"vld::i32()",[392,802,803],{},"vld::u64()","…) and are read exactly, without an ",[392,806,807],{},"f64"," round trip.",[437,810,811,812,815,816,818],{},"Unknown object keys are stripped by default, as in Zod; use ",[392,813,814],{},".strict()"," on ",[392,817,561],{}," to reject them.",[437,820,821,822,598,825,828],{},"Unions return ",[392,823,824],{},"Either\u003CA, B>",[392,826,827],{},"Either3\u003CA, B, C>"," because Rust has no anonymous union types.",[389,830,831,832,834,835,838,839,843,844,453],{},"The core crate needs only ",[392,833,422],{}," and ",[392,836,837],{},"serde_json","; heavier validators sit behind ",[397,840,842],{"href":841},"\u002Fgetting-started\u002Finstallation#features","features",". Web, OpenAPI, codegen, database, messaging, config, CLI and UI crates are listed under ",[397,845,140],{"href":153},[389,847,848,849,852,853,453],{},"Next: ",[397,850,851],{"href":16},"install the crate"," and follow the ",[397,854,855],{"href":20},"quick start",{"title":857,"searchDepth":858,"depth":859,"links":860},"",2,3,[861,862],{"id":416,"depth":858,"text":417},{"id":494,"depth":858,"text":495},"What vld is, what problem it solves and how it compares to Zod and serde.","md",null,{},true,{"title":11,"description":863},"HHetrorik7vkoAVAYDi7vCFgj5Xw_F-cNYxNPCwjKwY",[865,871],{"title":15,"path":16,"stem":17,"description":872,"children":-1},"Add vld to Cargo.toml and pick the features you need.",1795290653325]