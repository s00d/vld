::number().int().min(0).max(150),\n    }\n}\n\ndiesel::table! {\n    users (id) {\n        id -> Integer,\n        name -> Text,\n        email -> Text,\n        age -> BigInt,\n    }\n}\n\n#[derive(Debug, Insertable, serde::Serialize)]\n#[diesel(table_name = users)]\nstruct NewUser { name: String, email: String, age: i64 }\n\nfn insert(conn: &mut SqliteConnection) -> Result\u003C(), Box\u003Cdyn std::error::Error>> {\n    let user = NewUser { name: \"Bob\".into(), email: \"bob@example.com\".into(), age: 25 };\n    let validated = Validated::\u003CNewUserSchema, _>::new(user)?;\n    diesel::insert_into(users::table)\n        .values(validated.inner())\n        .execute(conn)?;\n    Ok(())\n}\n","rust",[344,560,561,579,592,598,612,630,645,695,724,772,778,784,789,802,818,833,846,858,871,876,881,886,915,934,969,974,1037,1098,1136,1159,1181,1195,1204],{"__ignoreMap":375},[379,562,563,567,570,573,576],{"class":381,"line":382},[379,564,566],{"class":565},"sbssI","use",[379,568,569],{"class":389}," diesel",[379,571,572],{"class":385},"::",[379,574,575],{"class":389},"prelude",[379,577,578],{"class":385},"::*;\n",[379,580,581,583,586,588,590],{"class":381,"line":396},[379,582,566],{"class":565},[379,584,585],{"class":389}," vld_diesel",[379,587,572],{"class":385},[379,589,575],{"class":389},[379,591,578],{"class":385},[379,593,594],{"class":381,"line":416},[379,595,597],{"emptyLinePlaceholder":596},true,"\n",[379,599,600,603,605,609],{"class":381,"line":435},[379,601,602],{"class":389},"vld",[379,604,572],{"class":385},[379,606,608],{"class":607},"s2Zo4","schema!",[379,610,611],{"class":385}," {\n",[379,613,615,618,621,624,627],{"class":381,"line":614},5,[379,616,617],{"class":385},"    #[",[379,619,620],{"class":399},"derive",[379,622,623],{"class":385},"(",[379,625,626],{"class":389},"Debug",[379,628,629],{"class":385},")]\n",[379,631,633,637,640,643],{"class":381,"line":632},6,[379,634,636],{"class":635},"spNyl","    pub",[379,638,639],{"class":635}," struct",[379,641,64