\n    users (id) {\n        id -> Integer,\n        name -> Text,\n        email -> Text,\n        age -> BigInt,\n    }\n}\n\n#[derive(Debug, Insertable, serde::Serialize)]\n#[diesel(table_name = users)]\nstruct NewUser { name: String, email: String, age: i64 }\n\nfn insert(conn: &mut SqliteConnection) -> Result\u003C(), Box\u003Cdyn std::error::Error>> {\n    let user = NewUser { name: \"Bob\".into(), email: \"bob@example.com\".into(), age: 25 };\n    let validated = Validated::\u003CNewUserSchema, _>::new(user)?;\n    diesel::insert_into(users::table)\n        .values(validated.inner())\n        .execute(conn)?;\n    Ok(())\n}\n","rust",[392,590,591,609,626,632,646,664,679,730,759,807,813,819,824,836,852,867,880,892,905,910,915,920,949,968,1003,1008,1071,1132,1170,1194,1216,1230,1239],{"__ignoreMap":424},[428,592,593,597,600,603,606],{"class":430,"line":431},[428,594,596],{"class":595},"sbssI","use",[428,598,599],{"class":438}," diesel",[428,601,602],{"class":434},"::",[428,604,605],{"class":438},"prelude",[428,607,608],{"class":434},"::*;\n",[428,610,611,613,616,618,620,622,624],{"class":430,"line":445},[428,612,596],{"class":595},[428,614,615],{"class":438}," vld_data",[428,617,602],{"class":434},[428,619,501],{"class":438},[428,621,602],{"class":434},[428,623,605],{"class":438},[428,625,608],{"class":434},[428,627,628],{"class":430,"line":465},[428,629,631],{"emptyLinePlaceholder":630},true,"\n",[428,633,634,637,639,643],{"class":430,"line":521},[428,635,636],{"class":438},"vld",[428,638,602],{"class":434},[428,640,642],{"class":641},"s2Zo4","schema!",[428,644,645],{"class":434}," {\n",[428,647,649,652,655,658,661],{"class":430,"line":648},5,[428,650,651],{"class":434},"    #[",[428,653,654],{"class":448},"derive",[428,656,657],{"class":434},"(",[428,659,660],{"class":438},"Debug",[428,662,663],{"class":434},")]\n",[428,665,667,671,674,677],{"class":430,"line":666},6,[428,668,670],{"class":669},"spNyl","    pub",[428,672,673],{"class":669}," struct",[428,675,6