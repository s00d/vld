9,1230,1219,1233,1235,1236,1239,1240,1243,1244,1247,1248,787],{},[392,1231,1232],{},"RowError { line, record, error }",[392,1234,424],{}," is the 1-based line where the record starts (the header is line 1, a quoted multi-line cell keeps the start line); ",[392,1237,1238],{},"record"," holds the cells when the record was read; ",[392,1241,1242],{},"error"," is ",[392,1245,1246],{},"RowErrorKind::Validation(VldError)"," or ",[392,1249,1250],{},"RowErrorKind::Csv(csv::Error)",[407,1252,1254],{"id":1253},"gotchas","Gotchas",[1201,1256,1257,1292,1303,1318,1321,1328,1331],{},[1204,1258,1259,1260,1263,1264,1267,1268,1271,1272,1275,1276,1279,1280,1283,1284,1287,1288,1291],{},"Cells are text, coerced like ",[397,1261,1262],{"href":197},"web query strings"," (",[392,1265,1266],{},"vld::schema::coerce_text"," + ",[392,1269,1270],{},"parse_coerced","): ",[392,1273,1274],{},"30"," is a number for ",[392,1277,1278],{},"vld::number()"," and stays ",[392,1281,1282],{},"\"30\""," for ",[392,1285,1286],{},"vld::string()","; ",[392,1289,1290],{},"01234"," is never a number.",[1204,1293,1294,1295,1298,1299,1302],{},"An empty cell is ",[392,1296,1297],{},"\"\"",". A column that may be blank: ",[392,1300,1301],{},".blank_as(default)"," (a missing column takes the default too).",[1204,1304,1305,1306,1309,1310,1313,1314,1317],{},"A record with a different number of fields than the header row is a ",[392,1307,1308],{},"RowErrorKind::Csv"," error by default; with ",[392,1311,1312],{},"csv::ReaderBuilder::new().flexible(true)"," a short record lacks the missing keys (",[392,1315,1316],{},"missing_field",") and extra cells are ignored.",[1204,1319,1320],{},"Header columns the schema does not know are ignored.",[1204,1322,1323,1324,1327],{},"The reader needs a header row (",[392,1325,1326],{},"has_headers(true)",", the default); without one the only item is an error at line 1.",[1204,1329,1330],{},"A malformed record (invalid UTF-8, wrong field count) does not stop the iteration; an I\u002FO error does.",[1204,1332,1333,1334,1337],{},"Configure trimming, delimiters and quoting on ",[392,1335,1336],{},"csv::ReaderBuilder","; the module only maps and validates.",[1339,1340,1341],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-te