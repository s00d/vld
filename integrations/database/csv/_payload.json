"),\n    }\n}\n","rust",[392,564,565,587,593,607,624,639,679,716,754,792,798,804,809,843,894,935,952,973,979,999,1005,1010,1015,1020,1026,1072,1082,1116,1186,1191],{"__ignoreMap":418},[422,566,567,571,574,577,579,581,584],{"class":424,"line":425},[422,568,570],{"class":569},"sbssI","use",[422,572,573],{"class":432}," vld_data",[422,575,576],{"class":428},"::",[422,578,404],{"class":432},[422,580,576],{"class":428},[422,582,583],{"class":432},"prelude",[422,585,586],{"class":428},"::*;\n",[422,588,589],{"class":424,"line":439},[422,590,592],{"emptyLinePlaceholder":591},true,"\n",[422,594,595,598,600,604],{"class":424,"line":459},[422,596,597],{"class":432},"vld",[422,599,576],{"class":428},[422,601,603],{"class":602},"s2Zo4","schema!",[422,605,606],{"class":428}," {\n",[422,608,609,612,615,618,621],{"class":424,"line":505},[422,610,611],{"class":428},"    #[",[422,613,614],{"class":442},"derive",[422,616,617],{"class":428},"(",[422,619,620],{"class":432},"Debug",[422,622,623],{"class":428},")]\n",[422,625,627,631,634,637],{"class":424,"line":626},5,[422,628,630],{"class":629},"spNyl","    pub",[422,632,633],{"class":629}," struct",[422,635,636],{"class":432}," User",[422,638,606],{"class":428},[422,640,642,645,648,651,654,657,660,662,665,668,671,673,676],{"class":424,"line":641},6,[422,643,644],{"class":629},"        pub",[422,646,647],{"class":442}," name",[422,649,650],{"class":428},":",[422,652,653],{"class":432}," String",[422,655,656],{"class":428}," =>",[422,658,659],{"class":432}," vld",[422,661,576],{"class":428},[422,663,664],{"class":602},"string",[422,666,667],{"class":428},"().",[422,669,670],{"class":602},"min",[422,672,617],{"class":428},[422,674,675],{"class":569},"2",[422,677,678],{"class":428},"),\n",[422,680,682,684,687,689,691,693,695,697,699,701,704,706,709,712],{"class":424,"line":681},7,[422,683,644],{"class":629},[422,685,686],{"class":442}," zip",[422,688,650],{"class":428},[422,690,653],{"class":432},[422,692,656],{"class":428},[422,694,659],