aterial-theme-palenight","use vld_data::surrealdb::prelude::*;\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct PersonSchema {\n        pub name: String  => vld::string().min(1).max(100),\n        pub email: String => vld::string().email(),\n        pub age: i64      => vld::number().int().min(0).max(150),\n    }\n}\n\n#[derive(serde::Serialize)]\nstruct Person { name: String, email: String, age: i64 }\n\nlet person = Person { name: \"Alice\".into(), email: \"alice@example.com\".into(), age: 30 };\n\u002F\u002F Before db.create(\"person\").content(person):\nvalidate_content::\u003CPersonSchema, _>(&person).unwrap();\n\n\u002F\u002F Inline checks for a MERGE:\nlet name = \"Bob\";\nlet email = \"bob@example.com\";\nvalidate_fields! {\n    name => vld::string().min(1),\n    email => vld::string().email(),\n}\n.unwrap();\n\n\u002F\u002F Serializable error body for an API response:\nlet bad = Person { name: \"\".into(), email: \"x\".into(), age: 200 };\nif let Err(e) = validate_content::\u003CPersonSchema, _>(&bad) {\n    let body = VldSurrealResponse::from_error(&e).to_json();\n    assert_eq!(body[\"error\"], \"Validation failed\");\n}\n","rust",[392,490,491,513,519,533,551,566,617,646,694,700,706,711,730,768,773,836,843,874,879,885,905,924,932,957,977,982,991,996,1002,1055,1099,1130,1163],{"__ignoreMap":421},[425,492,493,497,500,503,505,507,510],{"class":427,"line":428},[425,494,496],{"class":495},"sbssI","use",[425,498,499],{"class":435}," vld_data",[425,501,502],{"class":431},"::",[425,504,402],{"class":435},[425,506,502],{"class":431},[425,508,509],{"class":435},"prelude",[425,511,512],{"class":431},"::*;\n",[425,514,515],{"class":427,"line":442},[425,516,518],{"emptyLinePlaceholder":517},true,"\n",[425,520,521,524,526,530],{"class":427,"line":462},[425,522,523],{"class":435},"vld",[425,525,502],{"class":431},[425,527,529],{"class":528},"s2Zo4","schema!",[425,531,532],{"class":431}," {\n",[425,534,536,539,542,545,548],{"class":427,"line":535},4,[425,537,538],