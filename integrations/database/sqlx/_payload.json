and Diesel)",[389,649,650,651,654,655,658,659,420],{},"Both modules have the same API and can be enabled together. ",[392,652,653],{},"vld-data"," enables no SQLx runtime or TLS feature: pick them on your own ",[392,656,657],{},"sqlx"," dependency, the same major as the module you use. The examples use ",[392,660,661],{},"sqlx08",[422,663,665],{"id":664},"example","Example",[427,667,671],{"className":668,"code":669,"language":670,"meta":433,"style":433},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use sqlx::SqlitePool;\nuse vld_data::sqlx08::prelude::*;\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct NewUserSchema {\n        pub name: String  => vld::string().min(1).max(100),\n        pub email: String => vld::string().email(),\n        pub age: i64      => vld::number().int().min(0).max(150),\n    }\n}\n\n\u002F\u002F A column schema: the wrapper is checked as `{\"value\": ...}`.\nvld::schema! {\n    #[derive(Debug)]\n    pub struct EmailField {\n        pub value: String => vld::string().email(),\n    }\n}\n\n#[derive(Debug, serde::Serialize)]\nstruct NewUser { name: String, email: String, age: i64 }\n\nasync fn insert(pool: &SqlitePool) -> Result\u003C(), Box\u003Cdyn std::error::Error>> {\n    let user = NewUser { name: \"Alice\".into(), email: \"alice@example.com\".into(), age: 30 };\n    validate_insert::\u003CNewUserSchema, _>(&user)?;\n    sqlx::query(\"INSERT INTO users (name, email, age) VALUES (?, ?, ?)\")\n        .bind(&user.name)\n        .bind(&user.email)\n        .bind(user.age)\n        .execute(pool)\n        .await?;\n\n    \u002F\u002F Validated column value, bound directly.\n    let email = VldText::\u003CEmailField>::new(\"carol@example.com\")?;\n    sqlx::query(\"UPDATE users SET email = ? WHERE name = 'Alice'\")\n        .bind(&email)\n        .execute(pool)\n        .await?;\n    Ok(())\n}\n","rust",[392,672,673,691,710,716,730,748,763,814,843,891,897,903,908,915,926,939,951,977,