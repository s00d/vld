.min(0).max(150),\n    }\n}\n\n\u002F\u002F A column schema: the wrapper is checked as `{\"value\": ...}`.\nvld::schema! {\n    #[derive(Debug)]\n    pub struct EmailField {\n        pub value: String => vld::string().email(),\n    }\n}\n\n#[derive(Debug, serde::Serialize)]\nstruct NewUser { name: String, email: String, age: i64 }\n\nasync fn insert(pool: &SqlitePool) -> Result\u003C(), Box\u003Cdyn std::error::Error>> {\n    let user = NewUser { name: \"Alice\".into(), email: \"alice@example.com\".into(), age: 30 };\n    validate_insert::\u003CNewUserSchema, _>(&user)?;\n    sqlx::query(\"INSERT INTO users (name, email, age) VALUES (?, ?, ?)\")\n        .bind(&user.name)\n        .bind(&user.email)\n        .bind(user.age)\n        .execute(pool)\n        .await?;\n\n    \u002F\u002F Validated column value, bound directly.\n    let email = VldText::\u003CEmailField>::new(\"carol@example.com\")?;\n    sqlx::query(\"UPDATE users SET email = ? WHERE name = 'Alice'\")\n        .bind(&email)\n        .execute(pool)\n        .await?;\n    Ok(())\n}\n","rust",[344,689,690,708,723,729,743,761,776,826,855,903,909,915,920,926,937,950,962,988,993,998,1003,1027,1062,1067,1130,1191,1217,1240,1261,1278,1296,1310,1322,1327,1333,1368,1388,1401,1414,1423,1432],{"__ignoreMap":384},[388,691,692,696,699,702,705],{"class":390,"line":391},[388,693,695],{"class":694},"sbssI","use",[388,697,698],{"class":398}," sqlx",[388,700,701],{"class":394},"::",[388,703,704],{"class":398},"SqlitePool",[388,706,707],{"class":394},";\n",[388,709,710,712,715,717,720],{"class":390,"line":405},[388,711,695],{"class":694},[388,713,714],{"class":398}," vld_sqlx",[388,716,701],{"class":394},[388,718,719],{"class":398},"prelude",[388,721,722],{"class":394},"::*;\n",[388,724,725],{"class":390,"line":425},[388,726,728],{"emptyLinePlaceholder":727},true,"\n",[388,730,731,734,736,740],{"class":390,"line":444},[388,732,733],{"class":398},"vld",[388,735,701],{"class":394},[388,737,739],{"class":738},"s2Zo4","schema