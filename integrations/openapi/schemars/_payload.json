);\n\nlet json = serde_json::json!({\"name\": \"Widget\", \"price\": 9.99});\nlet product = Product::vld_parse(&json).unwrap();       \u002F\u002F validate + deserialize\nassert!(product.vld_validate().is_ok());                 \u002F\u002F validate an instance\nassert!(Product::vld_validate_json(&serde_json::json!({\"name\": 1})).is_err());\n","rust",[345,641,642,660,674,680,686,701,719,734,784,813,861,867,873,887,892,923,964,1019,1024,1030,1071,1082,1095,1108,1113,1126,1131,1190,1223,1250],{"__ignoreMap":403},[407,643,644,648,651,654,657],{"class":409,"line":410},[407,645,647],{"class":646},"sbssI","use",[407,649,650],{"class":417}," vld_schemars",[407,652,653],{"class":413},"::",[407,655,656],{"class":417},"prelude",[407,658,659],{"class":413},"::*;\n",[407,661,662,664,666,668,671],{"class":409,"line":424},[407,663,647],{"class":646},[407,665,650],{"class":417},[407,667,653],{"class":413},[407,669,670],{"class":417},"schemars",[407,672,673],{"class":413},";\n",[407,675,676],{"class":409,"line":476},[407,677,679],{"emptyLinePlaceholder":678},true,"\n",[407,681,683],{"class":409,"line":682},4,[407,684,685],{"class":490},"\u002F\u002F vld -> schemars\n",[407,687,689,692,694,698],{"class":409,"line":688},5,[407,690,691],{"class":417},"vld",[407,693,653],{"class":413},[407,695,697],{"class":696},"s2Zo4","schema!",[407,699,700],{"class":413}," {\n",[407,702,704,707,710,713,716],{"class":409,"line":703},6,[407,705,706],{"class":413},"    #[",[407,708,709],{"class":427},"derive",[407,711,712],{"class":413},"(",[407,714,715],{"class":417},"Debug",[407,717,718],{"class":413},")]\n",[407,720,722,726,729,732],{"class":409,"line":721},7,[407,723,725],{"class":724},"spNyl","    pub",[407,727,728],{"class":724}," struct",[407,730,731],{"class":417}," UserSchema",[407,733,700],{"class":413},[407,735,737,740,743,746,749,752,755,757,760,763,766,768,771,773,776,778,781],{"class":409,"line":736},8,[407,738,739],{"class":724},"        pub",[407,741,742],{"class":427}," name",[407,744