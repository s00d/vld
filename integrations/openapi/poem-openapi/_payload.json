 name: String => vld::string().min(2).max(50),\n        pub email: String => vld::string().email(),\n        pub age: i64 => vld::number().int().min(18),\n        pub address: Address => vld::nested!(Address),\n    }\n}\nimpl_type!(NewUser, \"User\"); \u002F\u002F component name; default: the type name\n\nstruct Api;\n\n#[OpenApi]\nimpl Api {\n    \u002F\u002F\u002F Invalid body: 422 with every issue.\n    #[oai(path = \"\u002Fusers\", method = \"post\")]\n    async fn create(&self, body: VldJson\u003CNewUser>) -> VldJson\u003CNewUser> {\n        body\n    }\n\n    \u002F\u002F\u002F Invalid body: poem-openapi's own 400 with vld's message.\n    #[oai(path = \"\u002Fusers\u002Fplain\", method = \"post\")]\n    async fn create_plain(&self, body: Json\u003CNewUser>) -> Json\u003CString> {\n        Json(body.0.name)\n    }\n}\n\n#[tokio::main]\nasync fn main() -> std::io::Result\u003C()> {\n    let api = OpenApiService::new(Api, \"Users\", \"1.0\").server(\"http:\u002F\u002Flocalhost:3000\u002Fapi\");\n    let app = Route::new().nest(\"\u002Fapi\", api);\n    Server::new(TcpListener::bind(\"0.0.0.0:3000\")).run(app).await\n}\n","rust",[392,602,603,637,666,690,696,710,728,743,783,789,795,809,814,825,848,860,902,930,968,995,1000,1005,1031,1036,1048,1053,1063,1073,1079,1117,1167,1173,1178,1183,1189,1223,1265,1290,1295,1300,1305,1320,1354,1411,1449,1494],{"__ignoreMap":441},[445,604,605,609,612,615,618,620,623,625,628,631,634],{"class":447,"line":448},[445,606,608],{"class":607},"sbssI","use",[445,610,611],{"class":455}," poem",[445,613,614],{"class":451},"::{",[445,616,617],{"class":455},"Route",[445,619,505],{"class":451},[445,621,622],{"class":455}," Server",[445,624,505],{"class":451},[445,626,627],{"class":455}," listener",[445,629,630],{"class":451},"::",[445,632,633],{"class":455},"TcpListener",[445,635,636],{"class":451},"};\n",[445,638,639,641,644,646,649,651,654,656,659,661,664],{"class":447,"line":462},[445,640,608],{"class":607},[445,642,643],{"class":455}," poe