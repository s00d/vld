},[373,421,407],{"class":379},[373,423,425,428,430,433,436,438,440,442,445,448,451,453,456,458,461,463,466],{"class":375,"line":424},4,[373,426,427],{"class":393},"rocket ",[373,429,397],{"class":379},[373,431,432],{"class":379}," {",[373,434,435],{"class":393}," version ",[373,437,397],{"class":379},[373,439,400],{"class":379},[373,441,404],{"class":403},[373,443,444],{"class":379},"\"",[373,446,447],{"class":379},",",[373,449,450],{"class":393}," features ",[373,452,397],{"class":379},[373,454,455],{"class":379}," [",[373,457,444],{"class":379},[373,459,460],{"class":403},"json",[373,462,444],{"class":379},[373,464,465],{"class":379},"]",[373,467,468],{"class":379}," }\n",[341,470,471,472,474],{},"No features. MSRV 1.85 (see ",[345,473,23],{"href":24},").",[357,476,478],{"id":477},"example","Example",[362,480,485],{"className":481,"code":482,"filename":483,"language":484,"meta":368,"style":368},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use vld_rocket::prelude::*;\n\nvld::schema! {\n    #[derive(Debug, Clone)]\n    pub struct CreateUser {\n        pub name: String  => vld::string().min(2).max(50),\n        pub email: String => vld::string().email(),\n    }\n}\n\nvld::schema! {\n    #[derive(Debug, Clone)]\n    pub struct UserPath {\n        pub id: i64 => vld::number().int().min(1),\n    }\n}\n\n#[rocket::post(\"\u002Fusers\", data = \"\u003Cuser>\")]\nfn create_user(user: VldJson\u003CCreateUser>) -> String {\n    format!(\"created {}\", user.name)\n}\n\n\u002F\u002F\u002F Rocket needs every `\u003Cparam>` as an argument too; `VldPath` validates them.\n#[rocket::get(\"\u002Fusers\u002F\u003Cid>\")]\nfn get_user(id: &str, p: VldPath\u003CUserPath>) -> String {\n    let _ = id;\n    format!(\"user #{}\", p.id)\n}\n\n#[rocket::launch]\nfn rocket() -> _ {\n    rocket::build()\n        .mount(\"\u002Fapi\u002Fv1\", rocket::routes![create_user, get_user])\n        .register(\"\u002F\", vld_catchers())\n}\n","main.