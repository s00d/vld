},[370,1156,1157],{},"VldForm\u003CT>",[1139,1159,1160,1161,1164],{},"Data guard: ",[370,1162,1163],{},"application\u002Fx-www-form-urlencoded"," body",[1124,1166,1167,1172],{},[1139,1168,1169],{},[370,1170,1171],{},"VldQuery\u003CT>",[1139,1173,1174],{},"Request guard: query string",[1124,1176,1177,1182],{},[1139,1178,1179],{},[370,1180,1181],{},"VldPath\u003CT>",[1139,1183,1184,1185,1188,1189,1192,1193,1150],{},"Request guard: the route's dynamic segments (",[370,1186,1187],{},"\u003Cid>","; a trailing ",[370,1190,1191],{},"\u003Crest..>"," gets the remaining segments joined with ",[370,1194,1087],{},[1124,1196,1197,1202],{},[1139,1198,1199],{},[370,1200,1201],{},"VldHeaders\u003CT>",[1139,1203,1204,1205,1208,1209,1150],{},"Request guard: headers (",[370,1206,1207],{},"X-Request-Id"," → ",[370,1210,1211],{},"x_request_id",[1124,1213,1214,1219],{},[1139,1215,1216],{},[370,1217,1218],{},"VldCookie\u003CT>",[1139,1220,1221,1222,1225],{},"Request guard: cookies from all ",[370,1223,1224],{},"Cookie"," headers",[1124,1227,1228,1233],{},[1139,1229,1230],{},[370,1231,1232],{},"vld_catchers()",[1139,1234,1235,1236],{},"All four catchers below, for ",[370,1237,1238],{},".register(\"\u002F\", ...)",[1124,1240,1241,1256],{},[1139,1242,1243,1246,1247,1246,1250,1246,1253],{},[370,1244,1245],{},"vld_400_catcher",", ",[370,1248,1249],{},"vld_413_catcher",[370,1251,1252],{},"vld_415_catcher",[370,1254,1255],{},"vld_422_catcher",[1139,1257,1258],{},"JSON catchers for the individual statuses",[1124,1260,1261,1265],{},[1139,1262,1263],{},[370,1264,501],{},[1139,1266,1267,1268],{},"Everything above plus ",[370,1269,1270],{},"vld::prelude::*",[357,1272,1274],{"id":1273},"error-catchers","Error catchers",[341,1276,1277,1278,1280,1281,1284,1285,355],{},"A failed guard only sets the status; Rocket renders the response through a catcher. Without ",[370,1279,1232],{}," clients get Rocket's default HTML page. The vld catchers answer with the error body the guard stored for that status; when another guard failed with the same status (Rocket's own ",[370,1282,1283],{},"Json",", for example) they answer ",[370,1286,1287],{},"{\"error\": \"\u003Creason>\"}",[357,1289,1291],{"id":1290},"body-limits","Body limits",[341,1293,1294,1297,1298,1300,1301,1304,1305,1308,1309,1312,1313,573],{},[370,1295,1296],{},"VldJson"," reads up to Rocket's ",[370,1299,460],{}," limit and ",[370,1302,1303],{},"VldForm"," up to the ",[370,1306,1307],{},"form"," limit, configured in ",[370,1310,1311],{},"Rocket.toml"," or ",[370,1314,1315],{},"ROCKET_LIMITS",[362,1317,1319],{"className":364,"code":1318,"filename":1311,"language":367,"meta":368,"style":368},"[default.limits]\njson = \"8 MiB\"\nform = \"256 KiB\"\n",[370,1320,1321,1335,1349],{"__ignoreMap":368},[373,1322,1323,1325,1328,1330,1333],{"class":375,"line":376},[373,1324,380],{"class":379},[373,1326,1327],{"class":383},"default",[373,1329,355],{"class":393},[373,1331,1332],{"class":383},"limits",[373,1334,387],{"class":379},[373,1336,1337,1340,1342,1344,1347],{"class":375,"line":390},[373,1338,1339],{"class":393},"json ",[373,1341,397],{"class":379},[373,1343,400],{"class":379},[373,1345,1346],{"class":403},"8 MiB",[373,1348,407],{"class":379},[373,1350,1351,1354,1356,1358,1361],{"class":375,"line":410},[373,1352,1353],{"class":393},"form ",[373,1355,397],{"class":379},[373,1357,400],{"class":379},[373,1359,1360],{"class":403},"256 KiB",[373,1362,407],{"class":379},[341,1364,1365,1366,1368,1369,1371],{},"While a limit is left at Rocket's built-in default (1 MiB for ",[370,1367,460],{},", 32 KiB for ",[370,1370,1307],{},"), the shared 2 MiB applies instead, like in every other vld adapter.",[357,1373,1375],{"id":1374},"gotchas","Gotchas",[1377,1378,1379,1383,1397],"ul",{},[1380,1381,1382],"li",{},"Setting a limit to exactly Rocket's built-in value counts as \"unset\" and gives 2 MiB.",[1380,1384,1385,1388,1389,1392,1393,1396],{},[370,1386,1387],{},"VldPath"," works under any mount point (",[370,1390,1391],{},"\u002Fapi\u00