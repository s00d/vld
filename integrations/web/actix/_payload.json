erver::new(|| {\n        App::new()\n            .app_data(VldBodyLimit(8 * 1024 * 1024)) \u002F\u002F optional, default 2 MiB\n            .route(\"\u002Fusers\", web::post().to(create_user))\n            .route(\"\u002Fusers\u002F{id}\", web::get().to(get_user))\n            .route(\"\u002Fsearch\", web::get().to(search))\n    })\n    .bind(\"127.0.0.1:8080\")?\n    .run()\n    .await\n}\n","main.rs","rust",[393,548,549,582,616,622,636,654,669,720,748,754,760,765,776,789,801,839,844,849,854,865,878,890,920,969,974,979,984,1020,1064,1069,1074,1106,1145,1150,1155,1187,1249,1254,1259,1275,1308,1324,1337,1372,1411,1453,1488,1494,1515,1525,1534],{"__ignoreMap":425},[429,550,551,555,558,561,564,566,569,571,574,576,579],{"class":431,"line":432},[429,552,554],{"class":553},"sbssI","use",[429,556,557],{"class":439}," actix_web",[429,559,560],{"class":435},"::{",[429,562,563],{"class":439},"web",[429,565,489],{"class":435},[429,567,568],{"class":439}," App",[429,570,489],{"class":435},[429,572,573],{"class":439}," HttpResponse",[429,575,489],{"class":435},[429,577,578],{"class":439}," HttpServer",[429,580,581],{"class":435},"};\n",[429,583,584,586,589,592,594,596,599,601,604,606,609,611,614],{"class":431,"line":446},[429,585,554],{"class":553},[429,587,588],{"class":439}," vld_web",[429,590,591],{"class":435},"::",[429,593,502],{"class":439},[429,595,560],{"class":435},[429,597,598],{"class":439},"VldBodyLimit",[429,600,489],{"class":435},[429,602,603],{"class":439}," VldJson",[429,605,489],{"class":435},[429,607,608],{"class":439}," VldPath",[429,610,489],{"class":435},[429,612,613],{"class":439}," VldQuery",[429,615,581],{"class":435},[429,617,618],{"class":431,"line":466},[429,619,621],{"emptyLinePlaceholder":620},true,"\n",[429,623,624,627,629,633],{"class":431,"line":513},[429,625,626],{"class":439},"vld",[429,628,591],{"class":435},[429,630,632],{"class":631},"s2Zo4","schema!",[429,634,635],{"class":435}," {\n",[429,637,639,642,645,648,651],{"class":431,"line":638},5,