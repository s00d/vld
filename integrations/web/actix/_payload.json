,443],{"class":383,"line":432},4,[381,434,435],{"class":401},"actix-web ",[381,437,405],{"class":387},[381,439,408],{"class":387},[381,441,442],{"class":411},"4",[381,444,415],{"class":387},[341,446,447,448,452,453,455],{},"No features. Works with actix-web ",[449,450,451],"strong",{},"4.4+",". MSRV 1.85 (see ",[361,454,23],{"href":24},").",[366,457,459],{"id":458},"example","Example",[371,461,466],{"className":462,"code":463,"filename":464,"language":465,"meta":377,"style":377},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use actix_web::{web, App, HttpResponse, HttpServer};\nuse vld_actix::{VldBodyLimit, VldJson, VldPath, VldQuery};\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct CreateUser {\n        pub name: String => vld::string().min(2).max(50),\n        pub email: String => vld::string().email(),\n    }\n}\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct UserPath {\n        pub id: i64 => vld::number().int().min(1),\n    }\n}\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct Search {\n        pub q: String => vld::string().min(1),\n        pub page: Option\u003Ci64> => vld::number().int().min(1).optional(),\n    }\n}\n\nasync fn create_user(user: VldJson\u003CCreateUser>) -> HttpResponse {\n    HttpResponse::Created().body(format!(\"created {}\", user.name))\n}\n\nasync fn get_user(path: VldPath\u003CUserPath>) -> HttpResponse {\n    HttpResponse::Ok().body(format!(\"user #{}\", path.id))\n}\n\nasync fn search(q: VldQuery\u003CSearch>) -> HttpResponse {\n    HttpResponse::Ok().body(format!(\"{} (page {})\", q.q, q.page.unwrap_or(1)))\n}\n\n#[actix_web::main]\nasync fn main() -> std::io::Result\u003C()> {\n    HttpServer::new(|| {\n        App::new()\n            .app_data(VldBodyLimit(8 * 1024 * 1024)) \u002F\u002F optional, default 2 MiB\n            .route(\"\u002Fusers\", web::post().to(create_user))\n            .route(\"\u002Fusers\u002F{id}\", web::get().to(get_user))\n          