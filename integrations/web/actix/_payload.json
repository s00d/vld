g","9.changelog",{"id":384,"title":160,"body":385,"description":1826,"extension":1827,"links":1828,"meta":1837,"navigation":620,"path":161,"seo":1838,"stem":162,"__hash__":1839},"docs\u002F6.integrations\u002F1.web\u002F03.actix.md",{"type":386,"value":387,"toc":1820},"minimark",[388,413,418,526,537,541,1539,1549,1553,1711,1737,1741,1816],[389,390,391,392,396,397,396,400,403,404,407,408,412],"p",{},"Drop-in replacements for ",[393,394,395],"code",{},"web::Json",", ",[393,398,399],{},"web::Query",[393,401,402],{},"web::Path"," and ",[393,405,406],{},"web::Form",", plus header and cookie extractors. Shared behaviour (status codes, error body, coercion, header\u002Fcookie rules) is in the ",[409,410,411],"a",{"href":153},"web adapters overview",".",[414,415,417],"h2",{"id":416},"install","Install",[419,420,426],"pre",{"className":421,"code":422,"filename":423,"language":424,"meta":425,"style":425},"language-toml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","[dependencies]\nvld = \"0.8\"\nvld-web = { version = \"0.8\", features = [\"actix\"] }\nactix-web = \"4\"\n","Cargo.toml","toml","",[393,427,428,444,464,511],{"__ignoreMap":425},[429,430,433,437,441],"span",{"class":431,"line":432},"line",1,[429,434,436],{"class":435},"sMK4o","[",[429,438,440],{"class":439},"sBMFI","dependencies",[429,442,443],{"class":435},"]\n",[429,445,447,451,454,457,461],{"class":431,"line":446},2,[429,448,450],{"class":449},"sTEyZ","vld ",[429,452,453],{"class":435},"=",[429,455,456],{"class":435}," \"",[429,458,460],{"class":459},"sfazB","0.8",[429,462,463],{"class":435},"\"\n",[429,465,467,470,472,475,478,480,482,484,487,490,493,495,498,500,503,505,508],{"class":431,"line":466},3,[429,468,469],{"class":449},"vld-web ",[429,471,453],{"class":435},[429,473,474],{"class":435}," {",[429,476,477],{"class":449}," version ",[429,479,453],{"class":435},[429,481,456],{"class":435},[429,483,460],{"class":459},[429,485,486],{"class":435},"\"",[429,488,489],{"class"