,[430,1796,1648],{},[430,1798,1799,1800,1330,1803,1806,1807,615,1810,1813],{},"Salvo's ",[348,1801,1802],{},"secure_max_size",[348,1804,1805],{},"SecureMaxSize"," middleware, ",[348,1808,1809],{},"Request::set_secure_max_size",[348,1811,1812],{},"set_global_secure_max_size","); Salvo's built-in 64 KiB counts as unset",[397,1815,1816,1820,1822],{},[430,1817,1818],{},[348,1819,180],{},[430,1821,1648],{},[430,1823,1824],{},[348,1825,1764],{},[397,1827,1828,1832,1834],{},[430,1829,1830],{},[348,1831,184],{},[430,1833,1648],{},[430,1835,1836,1326,1839],{},[348,1837,1838],{},"vld_json_limit::\u003CT>(n)",[348,1840,1841],{},"vld_form_limit::\u003CT>(n)",[397,1843,1844,1848,1850],{},[430,1845,1846],{},[348,1847,188],{},[430,1849,468],{},[430,1851,1852,1853],{},"tonic's own ",[348,1854,1855],{},"max_decoding_message_size",[341,1857,1858,1859,1861,1862,1865,1866,1868,1869,1872],{},"Compressed request bodies: ",[348,1860,156],{}," decodes ",[348,1863,1864],{},"Content-Encoding"," itself (the limit applies to the decoded size), ",[348,1867,160],{}," does with its ",[348,1870,1871],{},"compress"," feature, the other adapters see the body as the framework delivers it.",[386,1874,122],{"id":1875},"openapi",[341,1877,1878,1879,1883,1884,1888,1889,1893,1894,615,1897,615,1900,1903,1904,1906,1907,1909],{},"The adapters only validate. To document the same schemas, use ",[345,1880,1881],{"href":199},[348,1882,198],{}," (framework-agnostic), ",[345,1885,1886],{"href":207},[348,1887,206],{}," (aide, usually with axum) or ",[345,1890,1891],{"href":203},[348,1892,202],{},". The error body structs (",[348,1895,1896],{},"ValidationErrorBody",[348,1898,1899],{},"ErrorBody",[348,1901,1902],{},"ErrorWithMessage",") live in ",[348,1905,298],{}," and are ",[348,1908,370],{}," types, so they can be registered as response schemas too.",[1911,1912,1913],"style",{},"html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code