554,1557,1558,857],{},"Names are lowercased and ",[348,1547,1548],{},"-"," becomes ",[348,1551,1552],{},"_",": ",[348,1555,1556],{},"X-Request-Id"," is the field ",[348,1559,1560],{},"x_request_id",[917,1562,1563,1569,1570,1573,1574,1577,1578,857],{},[835,1564,1565,1566,1568],{},"Header names that already contain ",[348,1567,1552],{}," are ignored."," Otherwise a client could send ",[348,1571,1572],{},"x_user: admin"," and fill the ",[348,1575,1576],{},"x_user"," field even behind a proxy that strips only ",[348,1579,1580],{},"X-User",[917,1582,1583,1584,1587,1588,857],{},"Repeated headers are joined with ",[348,1585,1586],{},"\", \""," before coercion. Non-UTF-8 bytes become ",[348,1589,1487],{},[1468,1591,420],{"id":1592},"cookies",[914,1594,1595,1602,1613],{},[917,1596,1597,1598,1601],{},"Every ",[348,1599,1600],{},"Cookie"," header is read (HTTP\u002F2 clients may send one header per cookie); they are joined before parsing.",[917,1603,1604,1330,1607,1495,1610,1612],{},[835,1605,1606],{},"The first occurrence of a name wins",[348,1608,1609],{},"sid=a; sid=b",[348,1611,345],{},"). Browsers send the most specific cookie first; letting a later one win would allow cookie tossing from a sibling subdomain.",[917,1614,1615,1616,1619,1620,1622,1623,805,1626,1631,1632,1634],{},"Names are used as-is (a cookie ",[348,1617,1618],{},"session-id"," needs a field named ",[348,1621,1618],{},", map it with ",[348,1624,1625],{},"as \"session-id\"",[345,1627,1628],{"href":81},[348,1629,1630],{},"schema!","). Values are unquoted, percent-decoded (",[348,1633,1479],{}," is kept) and coerced.",[386,1636,1638],{"id":1637},"body-limits","Body limits",[341,1640,1641,802,1643,1645,1646,1330,1649,1652,1653,1656],{},[348,1642,440],{},[348,1644,455],{}," never buffer more than the limit. The default everywhere is ",[835,1647,1648],{},"2 MiB",[348,1650,1651],{},"vld_http_common::DEFAULT_BODY_LIMIT",", the same as axum's ",[348,1654,1655],{},"DefaultBodyLimit","), regardless of the framework's