ss":387},[381,431,433,436,438,440,443],{"class":383,"line":432},4,[381,434,435],{"class":401},"axum ",[381,437,405],{"class":387},[381,439,408],{"class":387},[381,441,442],{"class":411},"0.8",[381,444,415],{"class":387},[341,446,447,448,451,452,454],{},"No features. Works with axum ",[449,450,442],"strong",{},". MSRV 1.85 (see ",[361,453,23],{"href":24},").",[366,456,458],{"id":457},"example","Example",[371,460,465],{"className":461,"code":462,"filename":463,"language":464,"meta":377,"style":377},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use axum::{routing::{get, post}, Router};\nuse vld_axum::{VldJson, VldPath, VldQuery};\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct CreateUser {\n        pub name: String => vld::string().min(2).max(50),\n        pub email: String => vld::string().email(),\n        pub age: Option\u003Ci64> => vld::number().int().min(0).max(150).optional(),\n    }\n}\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct UserPath {\n        pub id: i64 => vld::number().int().min(1),\n    }\n}\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct Search {\n        pub q: String => vld::string().min(1).max(200),\n        pub page: Option\u003Ci64> => vld::number().int().min(1).optional(),\n    }\n}\n\nasync fn create_user(VldJson(user): VldJson\u003CCreateUser>) -> String {\n    format!(\"created {}\", user.name)\n}\n\nasync fn get_user(VldPath(path): VldPath\u003CUserPath>) -> String {\n    format!(\"user #{}\", path.id)\n}\n\nasync fn search(VldQuery(q): VldQuery\u003CSearch>) -> String {\n    format!(\"{} (page {})\", q.q, q.page.unwrap_or(1))\n}\n\n#[tokio::main]\nasync fn main() {\n    let app = Router::new()\n        .route(\"\u002Fusers\", post(create_user))\n        .route(\"\u002Fusers\u002F{id}\", get(get_user))\n        .route(\"\u002Fsearch\", get(search));\n\n    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:3000\").await.unwrap();\n    axum::serve(listener,