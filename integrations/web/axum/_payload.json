route(\"\u002Fusers\", post(create_user))\n        .route(\"\u002Fusers\u002F{id}\", get(get_user))\n        .route(\"\u002Fsearch\", get(search));\n\n    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:3000\").await.unwrap();\n    axum::serve(listener, app).await.unwrap();\n}\n","main.rs","rust",[393,545,546,580,609,615,629,647,662,713,741,802,808,814,819,830,843,855,891,896,901,906,917,930,942,981,1025,1030,1035,1040,1082,1111,1116,1121,1158,1184,1189,1194,1231,1281,1286,1291,1307,1322,1343,1372,1406,1434,1439,1490,1521],{"__ignoreMap":425},[429,547,548,552,555,558,561,563,566,568,571,574,577],{"class":431,"line":432},[429,549,551],{"class":550},"sbssI","use",[429,553,554],{"class":439}," axum",[429,556,557],{"class":435},"::{",[429,559,560],{"class":439},"routing",[429,562,557],{"class":435},[429,564,565],{"class":439},"get",[429,567,489],{"class":435},[429,569,570],{"class":439}," post",[429,572,573],{"class":435},"},",[429,575,576],{"class":439}," Router",[429,578,579],{"class":435},"};\n",[429,581,582,584,587,590,592,594,597,599,602,604,607],{"class":431,"line":446},[429,583,551],{"class":550},[429,585,586],{"class":439}," vld_web",[429,588,589],{"class":435},"::",[429,591,156],{"class":439},[429,593,557],{"class":435},[429,595,596],{"class":439},"VldJson",[429,598,489],{"class":435},[429,600,601],{"class":439}," VldPath",[429,603,489],{"class":435},[429,605,606],{"class":439}," VldQuery",[429,608,579],{"class":435},[429,610,611],{"class":431,"line":466},[429,612,614],{"emptyLinePlaceholder":613},true,"\n",[429,616,617,620,622,626],{"class":431,"line":512},[429,618,619],{"class":439},"vld",[429,621,589],{"class":435},[429,623,625],{"class":624},"s2Zo4","schema!",[429,627,628],{"class":435}," {\n",[429,630,632,635,638,641,644],{"class":431,"line":631},5,[429,633,634],{"class":435},"    #[",[429,636,637],{"class":449},"derive",[429,639,640],{"class":435},"(",[429,642,643],{"class":439},"Debug",[429,645,646],{"class":435},")]\n",[429,648,650,654,657,660]