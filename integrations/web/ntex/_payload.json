e":694,"meta":366,"style":366},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use ntex::web::{self, App, HttpResponse, HttpServer};\nuse vld_ntex::{VldJson, VldPath, VldQuery};\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct CreateUser {\n        pub name: String => vld::string().min(2).max(50),\n        pub email: String => vld::string().email(),\n    }\n}\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct UserPath {\n        pub id: i64 => vld::number().int().min(1),\n    }\n}\n\nvld::schema! {\n    #[derive(Debug)]\n    pub struct Search {\n        pub q: String => vld::string().min(1),\n    }\n}\n\nasync fn create_user(user: VldJson\u003CCreateUser>) -> HttpResponse {\n    HttpResponse::Created().body(format!(\"created {}\", user.name))\n}\n\nasync fn get_user(path: VldPath\u003CUserPath>) -> HttpResponse {\n    HttpResponse::Ok().body(format!(\"user #{}\", path.id))\n}\n\nasync fn search(q: VldQuery\u003CSearch>) -> HttpResponse {\n    HttpResponse::Ok().body(format!(\"search: {}\", q.q))\n}\n\n#[ntex::main]\nasync fn main() -> std::io::Result\u003C()> {\n    let app = || {\n        App::new()\n            .route(\"\u002Fusers\", web::post().to(create_user))\n            .route(\"\u002Fusers\u002F{id}\", web::get().to(get_user))\n            .route(\"\u002Fsearch\", web::get().to(search))\n    };\n\n    \u002F\u002F ntex 4\n    HttpServer::new(async move |_| app())\n        .bind(\"127.0.0.1:8080\", ntex::SharedCfg::default())?\n        .run()\n        .await\n    \u002F\u002F ntex 3: HttpServer::new(async move || app()).bind(\"127.0.0.1:8080\")?.run().await\n}\n","main.rs","rust",[345,696,697,736,760,766,780,798,813,864,892,898,904,909,920,933,945,983,988,993,998,1009,1022,1034,1064,1069,1074,1079,1117,1161,1166,1171,1203,1242,1247,1252,1284,1320,1325,1330,1346,1379,1395,1409,1449,1491,1526,1532,1537,1543,1575,1610,1620,1629,1635],{"__ignoreMap":366},[370,698,699,703,706,709,712,715,718,720,723,7