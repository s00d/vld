],{"class":441}," {",[435,482,483],{"class":455}," version ",[435,485,459],{"class":441},[435,487,462],{"class":441},[435,489,466],{"class":465},[435,491,492],{"class":441},"\"",[435,494,495],{"class":441},",",[435,497,498],{"class":455}," features ",[435,500,459],{"class":441},[435,502,503],{"class":441}," [",[435,505,492],{"class":441},[435,507,508],{"class":465},"socketio",[435,510,492],{"class":441},[435,512,513],{"class":441},"]",[435,515,516],{"class":441}," }\n",[435,518,520,523,525,527,529],{"class":437,"line":519},4,[435,521,522],{"class":455},"socketio-next ",[435,524,459],{"class":441},[435,526,462],{"class":441},[435,528,417],{"class":465},[435,530,469],{"class":441},[532,533,534,550],"table",{},[535,536,537],"thead",{},[538,539,540,544,547],"tr",{},[541,542,543],"th",{},"Feature",[541,545,546],{},"Module",[541,548,549],{},"Notes",[551,552,553],"tbody",{},[538,554,555,560,564],{},[556,557,558],"td",{},[392,559,508],{},[556,561,562],{},[392,563,394],{},[556,565,566,567,569,570,573,574,577,578,581,582],{},"socketio-next 0.2 with default features off (no TLS backend); your own ",[392,568,404],{}," dependency with its default ",[392,571,572],{},"rustls"," (or ",[392,575,576],{},"native-tls",") feature adds ",[392,579,580],{},"https"," \u002F ",[392,583,584],{},"wss",[420,586,588],{"id":587},"example","Example",[425,590,594],{"className":591,"code":592,"language":593,"meta":431,"style":431},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use std::time::Duration;\nuse socketio_next::{Client, ClientBuilder, Event};\nuse vld_data::socketio::prelude::*;\n\nvld::schema! {\n    #[derive(Debug, serde::Serialize)]\n    pub struct ChatMessage {\n        pub text: String => vld::string().min(1).max(500),\n    }\n}\n\nvld::schema! {\n    #[derive(Debug, serde::Serialize)]\n    pub struct Saved {\n        pub id: i64 => vld::number().int().min(1),\n    }\n}\n\nasync fn run() -> Result\u003C(), VldSocketIoError> {\n    let client = ClientBuilder::new(\"http:\u002F\u002Flocalhost:3000\")\n        \u002F\u002F Runs only with a valid first argument; invalid ones are logged.\n        .on(\"chat\", validated(|msg: ChatMessage, _client: Client| async move {\n            println!(\"{}\", msg.text);\n        }))\n        \u002F\u002F The server emits `save` with a callback: the return value is\n        \u002F\u002F validated and sent as the ack.\n        .on(\"save\", answer(|msg: ChatMessage, _client: Client| async move {\n            Saved { id: 1 }\n        }))\n        \u002F\u002F Invalid data: tell the server instead of logging.\n        .on(\"strict\", validated_or(\n            |msg: ChatMessage, _client: Client| async move { \u002F* … *\u002F },\n            |event: Event, client: Client, error: VldSocketIoError| async move {\n                let _ = client.emit(\"rejected\", event.name().to_owned());\n            },\n        ))\n        .connect()\n        .await?;\n\n    emit(&client, \"chat\", &ChatMessage { text: \"hi\".into() })?;\n    let saved: Saved = emit_with_ack(\n        &client, \"save\", &ChatMessage { text: \"keep\".into() }, Duration::from_secs(5),\n    ).await?;\n    Ok(())\n}\n","rust",[392,595,596,619,645,664,670,685,713,728,779,785,791,796,807,828,840,877,882,887,892,924,954,961,1015,1040,1046,1052,1058,1103,1120,1125,1131,1155,1189,1227,1272,1278,1284,1295,1307,1312,1363,1383,1442,1452,1461],{"__ignoreMap":431},[435,597,598,602,605,608,611,613,616],{"class":437,"line":438},[435,599,601],{"class":600},"sbssI","use",[435,603,604],{"class":445}," std",[435,606,607],{"class":441},"::",[435,609,610],{"class":445},"time",[435,612,607],{"class":441},[435,614,615],{"class":445},"Duration",[435,617,618],{"class":441},";\n",[435,620,621,623,626,629,632,634,637,639,642],{"class":437,"line":452},[435,622,601],{"class":600},[435,624,625],{"class":445}," socketio_next",[435,627,628],{"class":441},"::{",[435,630,631],{"class":445},"Client",[435,633,495],{"class":441},[435,635