n\nfn main() -> Result\u003C(), Box\u003Cdyn std::error::Error>> {\n    let client = redis::Client::open(\"redis:\u002F\u002F127.0.0.1\u002F\")?;\n    let mut conn = RedisConn::new(client.get_connection()?);\n\n    let alice = UserSchema { name: \"Alice\".into(), email: \"alice@example.com\".into() };\n    conn.set(\"user:1\", &alice)?;\n    let loaded: Option\u003CUserSchema> = conn.get(\"user:1\")?;\n    assert_eq!(loaded.unwrap().email, \"alice@example.com\");\n\n    let bad = UserSchema { name: \"\".into(), email: \"nope\".into() };\n    assert!(matches!(conn.set(\"user:2\", &bad), Err(VldRedisError::Validation(_))));\n    Ok(())\n}\n","rust",[392,617,618,640,657,663,678,706,721,772,800,806,812,817,865,901,935,940,993,1023,1065,1096,1101,1147,1207,1216],{"__ignoreMap":408},[412,619,620,624,627,630,632,634,637],{"class":414,"line":415},[412,621,623],{"class":622},"sbssI","use",[412,625,626],{"class":422}," vld_data",[412,628,629],{"class":418},"::",[412,631,605],{"class":422},[412,633,629],{"class":418},[412,635,636],{"class":422},"prelude",[412,638,639],{"class":418},"::*;\n",[412,641,642,644,646,648,650,652,654],{"class":414,"line":429},[412,643,623],{"class":622},[412,645,626],{"class":422},[412,647,629],{"class":418},[412,649,605],{"class":422},[412,651,629],{"class":418},[412,653,542],{"class":422},[412,655,656],{"class":418},";\n",[412,658,659],{"class":414,"line":449},[412,660,662],{"emptyLinePlaceholder":661},true,"\n",[412,664,666,669,671,675],{"class":414,"line":665},4,[412,667,668],{"class":422},"vld",[412,670,629],{"class":418},[412,672,674],{"class":673},"s2Zo4","schema!",[412,676,677],{"class":418}," {\n",[412,679,681,684,687,690,693,695,698,700,703],{"class":414,"line":680},5,[412,682,683],{"class":418},"    #[",[412,685,686],{"class":432},"derive",[412,688,689],{"class":418},"(",[412,691,692],{"class":422},"Debug",[412,694,472],{"class":418},[412,696,697],{"class":432}," serde",[412,699,629],{"class":418},[412,701,702],{"class":422},"Serialize",[4