, &Sum { sum: add.a + add.b }).await;\n            }\n        }\n    });\n\n    \u002F\u002F Caller: both directions are validated.\n    let sum: Sum = request(&client, \"math.add\", &Add { a: 2, b: 3 }).await?;\n    assert_eq!(sum.sum, 5);\n    Ok(())\n}\n","rust",[392,580,581,599,618,624,638,666,681,716,742,748,754,759,770,791,803,829,834,839,844,895,933,938,945,981,1001,1021,1058,1096,1161,1167,1173,1179,1184,1190,1250,1273,1282],{"__ignoreMap":428},[432,582,583,587,590,593,596],{"class":434,"line":435},[432,584,586],{"class":585},"sbssI","use",[432,588,589],{"class":442}," futures_util",[432,591,592],{"class":438},"::",[432,594,595],{"class":442},"StreamExt",[432,597,598],{"class":438},";\n",[432,600,601,603,606,608,610,612,615],{"class":434,"line":449},[432,602,586],{"class":585},[432,604,605],{"class":442}," vld_data",[432,607,592],{"class":438},[432,609,505],{"class":442},[432,611,592],{"class":438},[432,613,614],{"class":442},"prelude",[432,616,617],{"class":438},"::*;\n",[432,619,620],{"class":434,"line":469},[432,621,623],{"emptyLinePlaceholder":622},true,"\n",[432,625,626,629,631,635],{"class":434,"line":516},[432,627,628],{"class":442},"vld",[432,630,592],{"class":438},[432,632,634],{"class":633},"s2Zo4","schema!",[432,636,637],{"class":438}," {\n",[432,639,641,644,647,650,653,655,658,660,663],{"class":434,"line":640},5,[432,642,643],{"class":438},"    #[",[432,645,646],{"class":452},"derive",[432,648,649],{"class":438},"(",[432,651,652],{"class":442},"Debug",[432,654,492],{"class":438},[432,656,657],{"class":452}," serde",[432,659,592],{"class":438},[432,661,662],{"class":442},"Serialize",[432,664,665],{"class":438},")]\n",[432,667,669,673,676,679],{"class":434,"line":668},6,[432,670,672],{"class":671},"spNyl","    pub",[432,674,675],{"class":671}," struct",[432,677,678],{"class":442}," Add",[432,680,637],{"class":438},[432,682,684,687,690,693,696,699,702,704,707,710,713],{"class":434,"line":683},7,[432,685,686],{"class":671},"        pub",[432,688,689]