2,585],{},"MSRV: 1.85, 1.88 with ",[344,580,508],{}," (see ",[583,584,23],"a",{"href":24},").",[356,587,589],{"id":588},"example","Example",[361,591,595],{"className":592,"code":593,"language":594,"meta":367,"style":367},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use vld_lapin::prelude::*;\n\nvld::schema! {\n    #[derive(Debug, serde::Serialize)]\n    pub struct EventSchema {\n        pub event: String => vld::string().min(1),\n        pub retries: i64 => vld::number().int().min(0).max(10),\n    }\n}\n\nasync fn run() -> Result\u003C(), Box\u003Cdyn std::error::Error>> {\n    let conn = lapin::Connection::connect(\n        \"amqp:\u002F\u002Fguest:guest@127.0.0.1:5672\u002F%2f\",\n        lapin::ConnectionProperties::default(),\n    )\n    .await?;\n    let channel = LapinChannel::new(conn.create_channel().await?);\n\n    channel\n        .queue_declare(\"events\", Default::default(), Default::default())\n        .await?;\n\n    let event = EventSchema { event: \"user.created\".into(), retries: 0 };\n    channel\n        .publish(\"\", \"events\", Default::default(), Default::default(), &event)\n        .await?;\n\n    if let Some(message) = channel.basic_get(\"events\", Default::default()).await? {\n        \u002F\u002F Ack when valid, nack when invalid: every message is settled.\n        let parsed: EventSchema = channel\n            .ack_or_nack_decode(&message, Default::default(), Default::default())\n            .await?;\n        println!(\"{}\", parsed.event);\n    }\n    Ok(())\n}\n","rust",[344,596,597,615,621,635,662,677,717,765,771,777,782,833,860,874,893,899,912,948,953,959,998,1007,1012,1054,1059,1106,1115,1120,1177,1183,1201,1233,1242,1264,1269,1278],{"__ignoreMap":367},[371,598,599,603,606,609,612],{"class":373,"line":374},[371,600,602],{"class":601},"sbssI","use",[371,604,605],{"class":381}," vld_lapin",[371,607,608],{"class":377},"::",[371,610,611],{"class":381},"prelude",[371,613,614],{"class":