lass":426}," [",[420,490,477],{"class":426},[420,492,493],{"class":450},"lapin-3",[420,495,477],{"class":426},[420,497,498],{"class":426},"]",[420,500,501],{"class":426}," }\n",[420,503,505,508,510,512,515],{"class":422,"line":504},4,[420,506,507],{"class":440},"lapin ",[420,509,444],{"class":426},[420,511,447],{"class":426},[420,513,514],{"class":450},"3",[420,516,454],{"class":426},[518,519,520,536],"table",{},[521,522,523],"thead",{},[524,525,526,530,533],"tr",{},[527,528,529],"th",{},"Feature",[527,531,532],{},"Module",[527,534,535],{},"Notes",[537,538,539,555,568],"tbody",{},[524,540,541,547,552],{},[542,543,544],"td",{},[392,545,546],{},"lapin-2",[542,548,549],{},[392,550,551],{},"vld_data::lapin2",[542,553,554],{},"lapin 2.x",[524,556,557,561,565],{},[542,558,559],{},[392,560,493],{},[542,562,563],{},[392,564,394],{},[542,566,567],{},"lapin 3.x",[524,569,570,575,580],{},[542,571,572],{},[392,573,574],{},"lapin-4",[542,576,577],{},[392,578,579],{},"vld_data::lapin4",[542,581,582,583],{},"lapin 4.10+, needs Rust ",[584,585,586],"strong",{},"1.88",[389,588,589,590,593,594,597],{},"The modules have the same API and can be enabled together. Your ",[392,591,592],{},"lapin"," dependency must be the major of the module you use. The examples use ",[392,595,596],{},"lapin3",".",[405,599,601],{"id":600},"example","Example",[410,603,607],{"className":604,"code":605,"language":606,"meta":416,"style":416},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use vld_data::lapin3::prelude::*;\n\nvld::schema! {\n    #[derive(Debug, serde::Serialize)]\n    pub struct EventSchema {\n        pub event: String => vld::string().min(1),\n        pub retries: i64 => vld::number().int().min(0).max(10),\n    }\n}\n\nasync fn run() -> Result\u003C(), Box\u003Cdyn std::error::Error>> {\n    let conn = lapin::Connection::connect(\n        \"amqp:\u002F\u002Fguest:guest@127.0.0.1:5672\u002F%2f\",\n        lapin::ConnectionProperties::default(),\n    )\n    .await?;\n    let channel = LapinChannel::new(conn.create_channel().await?);\n\n    channel\n        .queue_declare(\"events\", Default::default(), Default::default())\n        .await?;\n\n    let event = EventSchema { event: \"user.created\".into(), retries: 0 };\n    channel\n        .publish(\"\", \"events\", Default::default(), Default::default(), &event)\n        .await?;\n\n    if let Some(message) = channel.basic_get(\"events\", Default::default()).await? {\n        \u002F\u002F Ack when valid, nack when invalid: every message is settled.\n        let parsed: EventSchema = channel\n            .ack_or_nack_decode(&message, Default::default(), Default::default())\n            .await?;\n        println!(\"{}\", parsed.event);\n    }\n    Ok(())\n}\n","rust",[392,608,609,631,637,651,678,693,733,782,788,794,799,850,877,891,910,916,929,964,969,975,1014,1023,1028,1070,1075,1122,1131,1136,1193,1200,1218,1250,1259,1281,1286,1295],{"__ignoreMap":416},[420,610,611,615,618,621,623,625,628],{"class":422,"line":423},[420,612,614],{"class":613},"sbssI","use",[420,616,617],{"class":430}," vld_data",[420,619,620],{"class":426},"::",[420,622,596],{"class":430},[420,624,620],{"class":426},[420,626,627],{"class":430},"prelude",[420,629,630],{"class":426},"::*;\n",[420,632,633],{"class":422,"line":437},[420,634,636],{"emptyLinePlaceholder":635},true,"\n",[420,638,639,642,644,648],{"class":422,"line":457},[420,640,641],{"class":430},"vld",[420,643,620],{"class":426},[420,645,647],{"class":646},"s2Zo4","schema!",[420,649,650],{"class":426}," {\n",[420,652,653,656,659,662,665,667,670,672,675],{"class":422,"line":504},[420,654,655],{"class":426},"    #[",[420,657,658],{"class":440},"derive",[420,660,661],{"class":426},"(",[420,663,664],{"class":430},"Debug",[420,666,480],{"class":426},[420,668,669],{"class":440}," serde",[420,671,620],{"class":426},[420,673,674],{"class":430},"Serialize",[420,676,677],{"class":426},")]\n",[420,679,681,685,688,691],{"class":422,"line":6