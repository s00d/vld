84,"title":372,"body":385,"description":1187,"extension":1188,"links":1189,"meta":1190,"navigation":908,"path":373,"seo":1191,"stem":374,"__hash__":1192},"docs\u002F7.guides\u002F2.security.md",{"type":386,"value":387,"toc":1177},"minimark",[388,392,397,413,446,449,571,602,622,626,658,667,671,693,697,712,716,752,756,797,1072,1087,1107,1113,1117,1155,1159,1173],[389,390,391],"p",{},"vld is usually the first code that touches untrusted input. These are the places where a schema alone is not enough or where the defaults matter.",[393,394,396],"h2",{"id":395},"filesystem-paths-and-files","Filesystem paths and files",[389,398,399,403,404,407,408,412],{},[400,401,402],"code",{},"vld::path()"," and ",[400,405,406],{},"vld::file()"," check the input against the ",[409,410,411],"strong",{},"server's"," filesystem. Without a base directory:",[414,415,416,424,437],"ul",{},[417,418,419,420,423],"li",{},"any absolute path or ",[400,421,422],{},".."," is accepted;",[417,425,426,429,430,403,433,436],{},[400,427,428],{},"exists()",", ",[400,431,432],{},"file()",[400,434,435],{},"dir()"," reveal to the client whether arbitrary paths exist;",[417,438,439,441,442,445],{},[400,440,406],{}," opens and reads whatever file the client names (",[400,443,444],{},"{\"path\": \"\u002Fetc\u002Fpasswd\"}",").",[389,447,448],{},"Always confine user-supplied paths:",[450,451,456],"pre",{"className":452,"code":453,"language":454,"meta":455,"style":455},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","let avatar = vld::file()\n    .within(\"\u002Fsrv\u002Fuploads\")\n    .max_size(5 * 1024 * 1024)\n    .media_types(&[\"image\u002Fpng\", \"image\u002Fjpeg\"]);\n","rust","",[400,457,458,489,513,539],{"__ignoreMap":455},[459,460,463,467,471,475,479,482,486],"span",{"class":461,"line":462},"line",1,[459,464,466],{"class":465},"spNyl","let",[459,468,470],{"class":469},"sTEyZ"," avatar ",[459,472,474],{"class":473},"sMK4o","=",[459,476,478],{"class":477},"sBMFI"," vld",[459,480,481],{"class":473},"::",[459,483,485],{"class":484},"s2Zo4","file",[459,487,488],{"class":473},"()\n",[459,490,492,495,498,501,504,508,510],{"class":461,"line":491},2,[459,493,494],{"class":473},"    .",[459,496,497],{"class":484},"within",[459,499,500],{"class":473},"(",[459,502,503],{"class":473},"\"",[459,505,507],{"class":506},"sfazB","\u002Fsrv\u002Fuploads",[459,509,503],{"class":473},[459,511,512],{"class":473},")\n",[459,514,516,518,521,523,527,530,533,535,537],{"class":461,"line":515},3,[459,517,494],{"class":473},[459,519,520],{"class":484},"max_size",[459,522,500],{"class":473},[459,524,526],{"class":525},"sbssI","5",[459,528,529],{"class":473}," *",[459,531,532],{"class":525}," 1024",[459,534,529],{"class":473},[459,536,532],{"class":525},[459,538,512],{"class":473},[459,540,542,544,547,550,552,555,557,560,563,566,568],{"class":461,"line":541},4,[459,543,494],{"class":473},[459,545,546],{"class":484},"media_types",[459,548,549],{"class":473},"(&[",[459,551,503],{"class":473},[459,553,554],{"class":506},"image\u002Fpng",[459,556,503],{"class":473},[459,558,559],{"class":473},",",[459,561,562],{"class":473}," \"",[459,564,565],{"class":506},"image\u002Fjpeg",[459,567,503],{"class":473},[459,569,570],{"class":473},"]);\n",[389,572,573,576,577,429,580,582,583,429,586,589,590,593,594,597,598,601],{},[400,574,575],{},"within(base)"," resolves ",[400,578,579],{},".",[400,581,422],{}," and the symlinks of existing ancestors before checking containment, so ",[400,584,585],{},"\"..\u002Fetc\u002Fx\"",[400,587,588],{},"\"\u002Fsrv\u002Fuploads\u002F..\u002Fetc\u002Fx\""," and a symlink pointing outside are rejected (",[400,591,592],{},"path_outside_base","), even when the target does not exist. It returns ",[400,595,596],{},"base.join(input)",", so later file operations use the checked path. File reads stop after ",[400,599,600],{},"max_size + 1"," bytes.",[603,604,605],"note",{},[389,606,607,609,610,613,614,617,618,621],{},[400,608,497],{}," is a lexical check plus symlink resolution at validation time. If an attacker can create symlinks inside ",[400,611,612],{},"base"," between validation and use, open the file with OS-level protections (",[400,615,616],{},"openat2"," with ",[400,619,620],{},"RESOLVE_BENEATH",", a chroot or a container) as well.",[393,623,625],{"id":624},"urls","URLs",[389,627,628,631,632,635,636,639,640,403,643,646,647,650,651,654,655,579],{},[400,629,630],{},"string().url()"," accepts any ",[400,633,634],{},"http"," \u002F ",[400,637,638],{},"https"," URL, including ",[400,641,642],{},"http:\u002F\u002Flocalhost",[400,644,645],{},"http:\u002F\u002F10.0.0.1",". If your server fetches the URL (webhooks, link previews, image proxies), use ",[400,648,649],{},"url_strict()"," (feature ",[400,652,653],{},"string-advanced","): it rejects localhost, private, loopback, link-local and unspecified addresses, including IPv4-mapped IPv6 forms such as ",[400,656,657],{},"http:\u002F\u002F[::ffff:127.0.0.1]",[389,659,660,662,663,666],{},[400,661,649],{}," checks the URL ",[409,664,665],{},"text",". A public hostname can still resolve to a private address (DNS rebinding), so an SSRF-sensitive fetcher should also check the resolved IP before connecting.",[393,668,670],{"id":669},"request-bodies","Request bodies",[389,672,673,674,679,680,429,683,429,686,429,689,692],{},"Web adapters cap bodies by default (",[675,676,678],"a",{"href":677},"\u002Fintegrations\u002Fweb\u002Foverview#body-limits","body limits","). Set limits inside the body too: ",[400,681,682],{},"vld::array(..).max_len(n)",[400,684,685],{},"vld::record(..).max_keys(n)",[400,687,688],{},"vld::string().max(n)",[400,690,691],{},"vld::json_value().max_depth(n)","; a 2 MiB body can still hold a million tiny array items.",[393,694,696],{"id":695},"headers-and-cookies","Headers and cookies",[389,698,699,700,703,704,403,708,579],{},"The adapters ignore header names with ",[400,701,702],{},"_"," and take the first value of a repeated cookie; see ",[675,705,707],{"href":706},"\u002Fintegrations\u002Fweb\u002Foverview#headers","headers",[675,709,711],{"href":710},"\u002Fintegrations\u002Fweb\u002Foverview#cookies","cookies",[393,713,715],{"id":714},"error-output","Error output",[389,717,718,719,429,722,403,725,727,728,731,732,635,735,738,739,635,741,744,745,748,749,579],{},"Issues carry the received value (truncated to 100 characters, cut on character boundaries). The default web error body contains only ",[400,720,721],{},"path",[400,723,724],{},"message",[400,726,400],{},", not the value, but ",[400,729,730],{},"VldError","'s ",[400,733,734],{},"Display",[400,736,737],{},"Debug"," (what servers log) and a serialized ",[400,740,730],{},[400,742,743],{},"ValidationIssue"," include ",[400,746,747],{},"received",". Mark secrets with ",[400,750,751],{},"redact()",[393,753,755],{"id":754},"secrets-in-errors","Secrets in errors",[389,757,758,761,762,429,764,403,766,768,769,771,772,775,776,779,780,429,782,784,785,788,789,792,793,796],{},[400,759,760],{},".redact()"," works on any schema. Every issue it reports — nested ones in an object or array included — keeps ",[400,763,721],{},[400,765,400],{},[400,767,724],{},", and its ",[400,770,747],{}," becomes ",[400,773,774],{},"\"[redacted]\""," (",[400,777,778],{},"vld::error::REDACTED","). So ",[400,781,734],{},[400,783,737],{},", a serialized error, ",[400,786,787],{},"prettify_error",", translations and HTTP error bodies never contain the value. Built-in messages and ",[400,790,791],{},"with_messages"," templates never quote the input; a custom message that does (a ",[400,794,795],{},"try_transform"," error formatting the value, say) has each input string of 4+ characters in it replaced by the marker.",[450,798,800],{"className":452,"code":799,"language":454,"meta":455,"style":455},"let login = vld::object()\n    .field(\"user\", vld::string().min(1))\n    .field(\"password\", vld::string().min(12).require_digit().redact());\n\nlet err = login.parse(r#\"{\"user\": \"ada\", \"password\": \"hunter2\"}\"#).unwrap_err();\nassert_eq!(err.issues[0].path_string(), \".password\");\nassert_eq!(err.issues[0].received, Some(serde_json::json!(\"[redacted]\")));\nassert!(!err.to_string().contains(\"hunter2\"));\n",[400,801,802,820,859,904,910,950,991,1039],{"__ignoreMap":455},[459,803,804,806,809,811,813,815,818],{"class":461,"line":462},[459,805,466],{"class":465},[459,807,808],{"class":469}," login ",[459,810,474],{"class":473},[459,812,478],{"class":477},[459,814,481],{"class":473},[459,816,817],{"class":484},"object",[459,819,488],{"class":473},[459,821,822,824,827,829,831,834,836,838,840,842,845,848,851,853,856],{"class":461,"line":491},[459,823,494],{"class":473},[459,825,826],{"class":484},"field",[459,828,500],{"class":473},[459,830,503],{"class":473},[459,832,833],{"class":506},"user",[459,835,503],{"class":473},[459,837,559],{"class":473},[459,839,478],{"class":477},[459,841,481],{"class":473},[459,843,844],{"class":484},"string",[459,846,847],{"class":473},"().",[459,849,850],{"class":484},"min",[459,852,500],{"class":473},[459,854,855],{"class":525},"1",[459,857,858],{"class":473},"))\n",[459,860,861,863,865,867,869,872,874,876,878,880,882,884,886,888,891,893,896,898,901],{"class":461,"line":515},[459,862,494],{"class":473},[459,864,826],{"class":484},[459,866,500],{"class":473},[459,868,503],{"class":473},[459,870,871],{"class":506},"password",[459,873,503],{"class":473},[459,875,559],{"class":473},[459,877,478],{"class":477},[459,879,481],{"class":473},[459,881,844],{"class":484},[459,883,847],{"class":473},[459,885,850],{"class":484},[459,887,500],{"class":473},[459,889,890],{"class":525},"12",[459,892,445],{"class":473},[459,894,895],{"class":484},"require_digit",[459,897,847],{"class":473},[459,899,900],{"class":484},"redact",[459,902,903],{"class":473},"());\n",[459,905,906],{"class":461,"line":541},[459,907,909],{"emptyLinePlaceholder":908},true,"\n",[459,911,913,915,918,920,923,925,928,930,933,936,939,942,944,947],{"