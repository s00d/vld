459,1046,1047],{"class":473},"(!",[459,1049,960],{"class":469},[459,1051,579],{"class":473},[459,1053,1054],{"class":484},"to_string",[459,1056,847],{"class":473},[459,1058,1059],{"class":484},"contains",[459,1061,500],{"class":473},[459,1063,503],{"class":473},[459,1065,1066],{"class":506},"hunter2",[459,1068,503],{"class":473},[459,1070,1071],{"class":473},"));\n",[389,1073,1074,1075,403,1077,1080,1081,429,1084,579],{},"In ",[400,1076,88],{},[400,1078,1079],{},"schema!",", chain it in the field's schema: ",[400,1082,1083],{},"#[vld(vld::string().min(12).redact())]",[400,1085,1086],{},"pub password: String => vld::string().min(12).redact()",[389,1088,1089,1090,1093,1094,1097,1098,731,1101,1103,1104,445],{},"Redact the ",[409,1091,1092],{},"outermost"," schema whose issues can carry the secret. A check of an enclosing schema reports the value it saw: ",[400,1095,1096],{},"vld::array(vld::string().redact()).unique()"," puts the duplicate item in ",[400,1099,1100],{},"not_unique",[400,1102,747],{},", and a union with no matching variant reports the whole input. Redact the array or union itself (",[400,1105,1106],{},"vld::array(vld::string()).unique().redact()",[389,1108,1109,1110,1112],{},"Redaction covers errors only: the parsed output is the plain value, so keep it out of your own logs (a newtype with a masking ",[400,1111,737],{}," helps).",[393,1114,1116],{"id":1115},"passwords","Passwords",[389,1118,1119,1120,775,1124,429,1127,429,1130,429,1132,429,1135,1138,1139,1142,1143,1146,1147,635,1149,403,1152,1154],{},"Use the ",[675,1121,1123],{"href":1122},"\u002Fschemas\u002Fstrings#passwords","password rules",[400,1125,1126],{},"require_lowercase",[400,1128,1129],{},"require_uppercase",[400,1131,895],{},[400,1133,1134],{},"require_symbol",[400,1136,1137],{},"max_repeat",", and with the ",[400,1140,1141],{},"password-strength"," feature ",[400,1144,1145],{},"password_strength(score)"," backed by zxcvbn) together with ",[400,1148,850],{},[400,1150,1151],{},"max",[400,1153,751],{},". Each failed rule is its own issue, so a sign-up form can show all of them at once; prefer a length minimum and a strength score over many composition rules. Validation does not replace hashing: store passwords only as a slow salted hash (argon2, scrypt, bcrypt).",[393,1156,1158],{"id":1157},"regex","Regex",[389,1160,1161,1164,1165,1168,1169,445],{},[400,1162,1163],{},"pattern()"," uses ",[400,1166,1167],{},"regex-lite"," (linear time), so a pattern cannot be used for ReDoS; the built-in formats use no regex (",[675,1170,1172],{"href":1171},"\u002Fschemas\u002Fstrings#patterns","patterns",[1174,1175,1176],"style",{},"html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg