ibuting",{"title":328,"path":329,"stem":330},"FAQ","\u002Fguides\u002Ffaq","7.guides\u002F5.faq",{"title":332,"path":333,"stem":334},"Changelog","\u002Fchangelog","9.changelog",{"id":336,"title":316,"body":337,"description":771,"extension":772,"links":773,"meta":774,"navigation":775,"path":317,"seo":776,"stem":318,"__hash__":777},"docs\u002F7.guides\u002F2.security.md",{"type":338,"value":339,"toc":762},"minimark",[340,344,349,365,398,401,523,554,574,578,610,619,623,640,656,660,663,691,698,702,726,730,740,744,758],[341,342,343],"p",{},"vld is usually the first code that touches untrusted input. These are the places where a schema alone is not enough or where the defaults matter.",[345,346,348],"h2",{"id":347},"filesystem-paths-and-files","Filesystem paths and files",[341,350,351,355,356,359,360,364],{},[352,353,354],"code",{},"vld::path()"," and ",[352,357,358],{},"vld::file()"," check the input against the ",[361,362,363],"strong",{},"server's"," filesystem. Without a base directory:",[366,367,368,376,389],"ul",{},[369,370,371,372,375],"li",{},"any absolute path or ",[352,373,374],{},".."," is accepted;",[369,377,378,381,382,355,385,388],{},[352,379,380],{},"exists()",", ",[352,383,384],{},"file()",[352,386,387],{},"dir()"," reveal to the client whether arbitrary paths exist;",[369,390,391,393,394,397],{},[352,392,358],{}," opens and reads whatever file the client names (",[352,395,396],{},"{\"path\": \"\u002Fetc\u002Fpasswd\"}",").",[341,399,400],{},"Always confine user-supplied paths:",[402,403,408],"pre",{"className":404,"code":405,"language":406,"meta":407,"style":407},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","let avatar = vld::file()\n    .within(\"\u002Fsrv\u002Fuploads\")\n    .max_size(5 * 1024 * 1024)\n    .media_types(&[\"image\u002Fpng\", \"image\u002Fjpeg\"]);\n","rust","",[352,409,410,441,465,491],{"__ignoreMap":407},[411,412,415,419,423,427,431,434,438],"span",{"class":413,"line":414},"line",1,[411,416,418],{"class":417},"spNyl","let",[411,420,422],{"class":421},"sTEyZ"," avatar ",[411,424,426],{"class":425},"sMK4o","=",[411,428,430],{"class":429},"sBMFI"," vld",[411,432,433],{"class":425},"::",[411,435,437],{"class":436},"s2Zo4","file",[411,439,440],{"class":425},"()\n",[411,442,444,447,450,453,456,460,462],{"class":413,"line":443},2,[411,445,446],{"class":425},"    .",[411,448,449],{"class":436},"within",[411,451,452],{"class":425},"(",[411,454,455],{"class":425},"\"",[411,457,459],{"class":458},"sfazB","\u002Fsrv\u002Fuploads",[411,461,455],{"class":425},[411,463,464],{"class":425},")\n",[411,466,468,470,473,475,479,482,485,487,489],{"class":413,"line":467},3,[411,469,446],{"class":425},[411,471,472],{"class":436},"max_size",[411,474,452],{"class":425},[411,476,478],{"class":477},"sbssI","5",[411,480,481],{"class":425}," *",[411,483,484],{"class":477}," 1024",[411,486,481],{"class":425},[411,488,484],{"class":477},[411,490,464],{"class":425},[411,492,494,496,499,502,504,507,509,512,515,518,520],{"class":413,"line":493},4,[411,495,446],{"class":425},[411,497,498],{"class":436},"media_types",[411,500,501],{"class":425},"(&[",[411,503,455],{"class":425},[411,505,506],{"class":458},"image\u002Fpng",[411,508,455],{"class":425},[411,510,511],{"class":425},",",[411,513,514],{"class":425}," \"",[411,516,517],{"class":458},"image\u002Fjpeg",[411,519,455],{"class":425},[411,521,522],{"class":425},"]);\n",[341,524,525,528,529,381,532,534,535,381,538,541,542,545,546,549,550,553],{},[352,526,527],{},"within(base)"," resolves ",[352,530,531],{},".",[352,533,374],{}," and the symlinks of existing ancestors before checking containment, so ",[352,536,537],{},"\"..\u002Fetc\u002Fx\"",[352,539,540],{},"\"\u002Fsrv\u002Fuploads\u002F..\u002Fetc\u002Fx\""," and a symlink pointing outside are rejected (",[352,543,544],{},"path_outside_base","), even when the target does not exist. It returns ",[352,547,548],{},"base.join(input)",", so later file operations use the checked path. File reads stop after ",[352,551,552],{},"max_size + 1"," bytes.",[555,556,557],"note",{},[341,558,559,561,562,565,566,569,570,573],{},[352,560,449],{}," is a lexical check plus symlink resolution at validation time. If an attacker can create symlinks inside ",[352,563,564],{},"base"," between validation and use, open the file with OS-level protections (",[352,567,568],{},"openat2"," with ",[352,571,572],{},"RESOLVE_BENEATH",", a chroot or a container) as well.",[345,575,577],{"id":576},"urls","URLs",[341,579,580,583,584,587,588,591,592,355,595,598,599,602,603,606,607,531],{},[352,581,582],{},"string().url()"," accepts any ",[352,585,586],{},"http"," \u002F ",[352,589,590],{},"https"," URL, including ",[352,593,594],{},"http:\u002F\u002Flocalhost",[352,596,597],{},"http:\u002F\u002F10.0.0.1",". If your server fetches the URL (webhooks, link previews, image proxies), use ",[352,600,601],{},"url_strict()"," (feature ",[352,604,605],{},"string-advanced","): it rejects localhost, private, loopback, link-local and unspecified addresses, including IPv4-mapped IPv6 forms such as ",[352,608,609],{},"http:\u002F\u002F[::ffff:127.0.0.1]",[341,611,612,614,615,618],{},[352,613,601],{}," checks the URL ",[361,616,617],{},"text",". A public hostname can still resolve to a private address (DNS rebinding), so an SSRF-sensitive fetcher should also check the resolved IP before connecting.",[345,620,622],{"id":621},"request-bodies","Request bodies",[341,624,625,626,629,630,633,634,639],{},"All web adapters cap JSON and form bodies at ",[361,627,628],{},"2 MiB"," by default and answer ",[361,631,632],{},"413"," above it, without buffering more. Raise the limit only for the routes that need it; see the ",[635,636,638],"a",{"href":637},"\u002Fintegrations\u002Fweb\u002Foverview#body-limits","body limits table",". Form bodies are limited to 1000 fields.",[341,641,642,643,381,646,381,649,355,652,655],{},"Set limits on collections inside the body too: ",[352,644,645],{},"vld::array(..).max_len(n)",[352,647,648],{},"vld::record(..).max_keys(n)",[352,650,651],{},"vld::string().max(n)",[352,653,654],{},"vld::json_value().max_depth(n)",". A 2 MiB body can still hold a million tiny array items.",[345,657,659],{"id":658},"headers-and-cookies","Headers and cookies",[341,661,662],{},"The adapters already defend against two classic tricks:",[366,664,665,680],{},[369,666,667,668,671,672,675,676,679],{},"Header names containing ",[352,669,670],{},"_"," are ignored, so ",[352,673,674],{},"x_user: admin"," cannot fill a field meant for ",[352,677,678],{},"X-User"," behind a proxy that only strips the dash form.",[369,681,682,683,686,687,690],{},"When a cookie name appears more than once (across all ",[352,684,685],{},"Cookie"," headers), the ",[361,688,689],{},"first"," value wins, which defeats cookie tossing from a sibling subdomain.",[341,692,693,694,531],{},"Details are in the ",[635,695,697],{"href":696},"\u002Fintegrations\u002Fweb\u002Foverview#headers","web overview",[345,699,701],{"id":700},"error-output","Error output",[341,703,704,705,381,708,355,711,713,714,717,718,721,722,725],{},"Issues carry the received value (truncated to 100 characters, cut on character boundaries). The default web error body contains only ",[352,706,707],{},"path",[352,709,710],{},"message",[352,712,352],{},", not the value. If you return ",[352,715,716],{},"VldError"," or ",[352,719,720],{},"ValidationIssue"," as JSON yourself, remember that ",[352,723,724],{},"received"," echoes client input; strip it for secrets such as passwords and tokens.",[345,727,729],{"id":728},"regex","Regex",[341,731,732,735,736,739],{},[352,733,734],{},"vld::string().pattern()"," uses ",[352,737,738],{},"regex-lite",", which has no backtracking and runs in linear time, so a pattern cannot be used for ReDoS. Patterns are compiled once, when the schema is built; the built-in formats use no regex at all.",[345,741,743],{"id":742},"fuzzing","Fuzzing",[341,745,746,747,750,751,754,755,531],{},"The ",[352,748,749],{},"fuzz\u002F"," directory has ",[352,752,753],{},"cargo-fuzz"," targets for the ISO date parsers, string formats, URL \u002F form \u002F cookie decoding and error truncation. See ",[635,756,324],{"href":757},"\u002Fguides\u002Fcontributing#fuzzing",[759,760,761],"style",{},"html pre.shiki code .spNyl, html code.shiki .spNyl{--shiki-light:#9C3EDA;--shiki-default:#C792EA;--shiki-dark:#C792EA}html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .s2Zo4, html code.shiki .s2Zo4{--shiki-light:#6182B8;--shiki-default:#82AAFF;--shiki-dark:#82AAFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sbssI, html code.shiki .sbssI{--shiki-light:#F76D47;--shiki-default:#F78C6C;--shiki-dark:#F78C6C}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-d